    m_Localized: "Geld"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Verhoogt de beloning per bezorgde doos."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Vrachtwagen"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Ontgrendelt extra vrachtwagenloodsen."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Questniveau"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Ontgrendelt quests van een hoger niveau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "DRUKKE DAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "De verschijningssnelheid van klanten stijgt met 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "BOZE KLANTEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Het geduld van klanten daalt met 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "TRAGE LOGISTIEK"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Vrachtwagens vertrekken 50% trager."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "ZWARE DOZEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "De algehele bewegingssnelheid daalt met 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "VERMOEIDHEIDSPROBLEEM"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Uithoudingsvermogen herstelt 40% trager en sprintsnelheid daalt met 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "VERRASSINGSCONTROLE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Alle foutieve handelingen worden dubbel bestraft."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "MARKETINGDAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% meer klanten, maar 30% minder inkomsten."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "KLANTENSERVICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "De receptietelefoon gaat 50% vaker over."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "LEVERINGSBONUS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Verdien 20% meer geld per levering."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "RUSTIGE DAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Het geduld van klanten stijgt met 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EXPRESVRACHT"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Vrachtwagens vertrekken 30% sneller."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "GOUDEN DOZENDAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Elke correct geleverde doos levert 30% extra op. Brengt ook 20% meer klanten, 20% snellere vrachtwagenvertrekken en 20% snellere beweging, maar uithoudingsvermogen herstelt 20% trager."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "KANSENDAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Upgradekosten dalen met 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "QUOTUMDAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Alle vrachtwagens vragen slechts één doos­kleur."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP-SERVICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% kans dat dozen perfect zijn en 10% meer opleveren."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "REGENDAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Er komen 20% minder klanten."
    m_Metadata:
      m_Items: []
