  - m_Id: 30569701396885504
    m_Localized: "Igraj na spletu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Igralci v predsobi"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Skupaj: {0} igralcev"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Stanje sobe za odmor"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Notri: {0} / {1} igralcev"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Vsi so pripravljeni!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Čakanje na {0} igralcev ..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Ni najdenih igralcev"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Igralec"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Vodič"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Samo gostitelj lahko odstrani igralce!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Igralec odstranjen!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Odstranitev ni uspela!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Prazno mesto"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "Dan {0}  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Dan je končan. Pojdi v sobo za odmor."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Dan najemnine"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "Stopnja: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Strošek: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: "Najv."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "Kupi"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Čakalna vrsta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Poveča največjo velikost čakalne vrste strank."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Vzdržljivost"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Poveča hitrost obnavljanja vzdržljivosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Denar"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Poveča nagrado za vsako dostavljeno škatlo."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Tovornjak"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Odklene dodatne hangarje za tovornjake."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Stopnja naloge"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Odklene naloge višje stopnje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "ZAPOSLEN DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Hitrost prihoda strank se poveča za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "JEZNE STRANKE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Potrpežljivost strank se zmanjša za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "POČASNA LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Tovornjaki zapustijo prizorišče 50 % počasneje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "TEŽKE ŠKATLE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Splošna hitrost gibanja se zmanjša za 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "TEŽAVA Z UTRUJENOSTJO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vzdržljivost se obnavlja 40 % počasneje, hitrost šprinta pa se zmanjša za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "NENAPOVEDAN NADZOR"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Vse napačne operacije se kaznujejo dvojno."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "DAN TRŽENJA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20 % več strank, a 30 % manj zaslužka."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "PODPORA STRANKAM"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Telefon na recepciji zvoni 50 % pogosteje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS ZA DOSTAVO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Zaslužite 20 % več denarja na dostavo."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "SPROŠČEN DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Potrpežljivost strank se poveča za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EKSPRESNI TOVOR"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Tovornjaki zapustijo prizorišče 30 % hitreje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "DAN ZLATE ŠKATLE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Vsaka pravilno dostavljena škatla prinese dodatnih 30 %. Prinese tudi 20 % več strank, 20 % hitrejše odhode tovornjakov in 20 % hitrejše gibanje, vendar se vzdržljivost obnavlja 20 % počasneje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "DAN PRILOŽNOSTI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Stroški nadgradenj se zmanjšajo za 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "DAN KVOTE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Vsi tovornjaki zahtevajo samo eno barvo škatle."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP STORITEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10 % možnosti, da je škatla popolna in prinese 10 % več."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "DEŽEVEN DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Prihaja 20 % manj strank."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "DAN FESTIVALA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Na začetku dneva se prejme naključni bonus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Igralci"
    m_Metadata:
      m_Items: []
