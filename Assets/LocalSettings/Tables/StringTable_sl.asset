    m_Metadata:
      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: Igraj na spletu
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: Igralci v predsobi
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: 'Skupaj: {0} igralcev'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Stanje sobe za odmor
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: 'Notri: {0} / {1} igralcev'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: Vsi so pripravljeni!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "\u010Cakanje na {0} igralcev ..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: Ni najdenih igralcev
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: Igralec
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Vodi\u010D"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: Samo gostitelj lahko odstrani igralce!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: Igralec odstranjen!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: Odstranitev ni uspela!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: Prazno mesto
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: Dan {0}  {1}:{2} ({3}s)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Dan je kon\u010Dan. Pojdi v sobo za odmor."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: Dan najemnine
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Stopnja: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Stro\u0161ek: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Najv.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Kupi
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "\u010Cakalna vrsta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Pove\u010Da najve\u010Djo velikost \u010Dakalne vrste strank."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Vzdr\u017Eljivost"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Pove\u010Da hitrost obnavljanja vzdr\u017Eljivosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Denar
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Pove\u010Da nagrado za vsako dostavljeno \u0161katlo."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Tovornjak
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: Odklene dodatne hangarje za tovornjake.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: Stopnja naloge
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Odklene naloge vi\u0161je stopnje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: ZAPOSLEN DAN
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Hitrost prihoda strank se pove\u010Da za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: JEZNE STRANKE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Potrpe\u017Eljivost strank se zmanj\u0161a za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "PO\u010CASNA LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Tovornjaki zapustijo prizori\u0161\u010De 50 % po\u010Dasneje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "TE\u017DKE \u0160KATLE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Splo\u0161na hitrost gibanja se zmanj\u0161a za 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "TE\u017DAVA Z UTRUJENOSTJO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vzdr\u017Eljivost se obnavlja 40 % po\u010Dasneje, hitrost \u0161printa
      pa se zmanj\u0161a za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: NENAPOVEDAN NADZOR
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Vse napa\u010Dne operacije se kaznujejo dvojno."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "DAN TR\u017DENJA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20 % ve\u010D strank, a 30 % manj zaslu\u017Eka."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: PODPORA STRANKAM
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: Telefon na recepciji zvoni 50 % pogosteje.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: BONUS ZA DOSTAVO
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Zaslu\u017Eite 20 % ve\u010D denarja na dostavo."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "SPRO\u0160\u010CEN DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Potrpe\u017Eljivost strank se pove\u010Da za 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: EKSPRESNI TOVOR
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Tovornjaki zapustijo prizori\u0161\u010De 30 % hitreje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "DAN ZLATE \u0160KATLE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Vsaka pravilno dostavljena \u0161katla prinese dodatnih 30 %. Prinese
      tudi 20 % ve\u010D strank, 20 % hitrej\u0161e odhode tovornjakov in 20 % hitrej\u0161e
      gibanje, vendar se vzdr\u017Eljivost obnavlja 20 % po\u010Dasneje."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "DAN PRILO\u017DNOSTI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Stro\u0161ki nadgradenj se zmanj\u0161ajo za 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: DAN KVOTE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Vsi tovornjaki zahtevajo samo eno barvo \u0161katle."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: VIP STORITEV
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10 % mo\u017Enosti, da je \u0161katla popolna in prinese 10 % ve\u010D."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "DE\u017DEVEN DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: Prihaja 20 % manj strank.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: DAN FESTIVALA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Na za\u010Detku dneva se prejme naklju\u010Dni bonus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: Igralci
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: ({0}/{1} v sobi za odmor)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: "Pri\u010Dakovane stranke"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: "Rde\u010Da"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000069
    m_Localized: Modra
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000070
