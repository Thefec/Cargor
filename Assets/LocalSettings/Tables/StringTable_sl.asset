    m_Metadata:
      m_Items: []
  - m_Id: 136808528593170433
    m_Localized: Spusti
    m_Metadata:
      m_Items: []
  - m_Id: 136808528593170434
    m_Localized: "<color=#4B4E6D>2</color>      Dobrodo\u0161li v Cargor!\n<color=#4B4E6D>3</color>     
      Osnovno gibanje\n<color=#4B4E6D>4</color>      Kako pakirati izdelke\n<color=#4B4E6D>5</color>     
      Postavljanje na police\n<color=#4B4E6D>6</color>      Tovornjaki in dostava\n<color=#4B4E6D>7</color>      
      Stranke\n<line-height=18><color=#4B4E6D>8</color>      Posebne zahteve: vra\u010Dila,\ndvojna
      naro\u010Dila, me\u0161ani tovornjaki</line-height>\n<color=#4B4E6D>9</color>     
      Najemnina in va\u0161 denar\n<color=#4B4E6D>10</color>   Nadgradnje\n<color=#4B4E6D>11</color>   
      Tabla nalog\n<color=#4B4E6D>12</color>    Telefonska linija\n<color=#4B4E6D>13</color>   
      Prostor za po\u010Ditek in konec dneva\n<color=#4B4E6D>14</color>    Nasveti
      za timsko delo"
    m_Metadata:
      m_Items: []
