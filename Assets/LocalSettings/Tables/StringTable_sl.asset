  - m_Id: 30570000000000079
    m_Localized: "Postavi {0} {1} \u0161katel na polico"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000080
    m_Localized: "Dokon\u010Daj {0} tovornjakov"
