    m_Localized: "Argent"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Augmente la récompense par carton livré."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Camion"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Débloque des hangars à camions supplémentaires."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Palier de quête"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Débloque des quêtes de niveau supérieur."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "JOURNÉE CHARGÉE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Le taux d'apparition des clients augmente de 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "CLIENTS EN COLÈRE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "La patience des clients diminue de 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "LOGISTIQUE RALENTIE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Les camions quittent les lieux 50 % plus lentement."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "CARTONS LOURDS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "La vitesse de déplacement globale diminue de 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBLÈME DE FATIGUE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "L'endurance se régénère 40 % plus lentement et la vitesse de sprint diminue de 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "CONTRÔLE SURPRISE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Toutes les erreurs entraînent une pénalité doublée."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "JOURNÉE MARKETING"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20 % de clients en plus, mais 30 % de revenus en moins."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "SERVICE CLIENT"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Le téléphone de la réception sonne 50 % plus souvent."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS DE LIVRAISON"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Gagnez 20 % de plus par livraison."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "JOURNÉE DÉTENDUE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "La patience des clients augmente de 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "FRET EXPRESS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Les camions quittent les lieux 30 % plus vite."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "JOURNÉE BOÎTE DORÉE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Chaque carton correctement livré rapporte 30 % de plus. Apporte aussi 20 % de clients en plus, des départs de camions 20 % plus rapides et un déplacement 20 % plus rapide, mais l'endurance se régénère 20 % plus lentement."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "JOUR DE L'OPPORTUNITÉ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Le coût des améliorations diminue de 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "JOUR DE QUOTA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Tous les camions demandent une seule couleur de carton."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "SERVICE VIP"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10 % de chances que les cartons soient parfaits et rapportent 10 % de plus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "JOUR DE PLUIE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "20 % de clients en moins arrivent."
    m_Metadata:
      m_Items: []
