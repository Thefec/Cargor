    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: 'Total : {0} joueurs'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "\xC9tat de la salle de repos"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "\xC0 l'int\xE9rieur : {0} / {1} joueurs"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Tout le monde est pr\xEAt !"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: En attente de {0} joueurs...
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Aucun joueur trouv\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: Joueur
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: Didacticiel
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Seul l'h\xF4te peut exclure des joueurs !"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: Joueur exclu !
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "\xC9chec de l'exclusion !"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: Emplacement libre
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: Jour {0}  {1}:{2} ({3}s)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Journ\xE9e termin\xE9e. Rendez-vous \xE0 la salle de repos."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: Jour du loyer
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Niveau : {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Co\xFBt : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Max
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Acheter
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: File d'attente
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: Augmente la taille maximale de la file d'attente des clients.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: Endurance
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Augmente la vitesse de r\xE9g\xE9n\xE9ration d'endurance."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Argent
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Augmente la r\xE9compense par carton livr\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Camion
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "D\xE9bloque des hangars \xE0 camions suppl\xE9mentaires."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Palier de qu\xEAte"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "D\xE9bloque des qu\xEAtes de niveau sup\xE9rieur."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "JOURN\xC9E CHARG\xC9E"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: Le taux d'apparition des clients augmente de 30 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "CLIENTS EN COL\xC8RE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: La patience des clients diminue de 30 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: LOGISTIQUE RALENTIE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: Les camions quittent les lieux 50 % plus lentement.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: CARTONS LOURDS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "La vitesse de d\xE9placement globale diminue de 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBL\xC8ME DE FATIGUE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "L'endurance se r\xE9g\xE9n\xE8re 40 % plus lentement et la vitesse
      de sprint diminue de 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "CONTR\xD4LE SURPRISE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Toutes les erreurs entra\xEEnent une p\xE9nalit\xE9 doubl\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "JOURN\xC9E MARKETING"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: 20 % de clients en plus, mais 30 % de revenus en moins.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: SERVICE CLIENT
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Le t\xE9l\xE9phone de la r\xE9ception sonne 50 % plus souvent."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: BONUS DE LIVRAISON
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: Gagnez 20 % de plus par livraison.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "JOURN\xC9E D\xC9TENDUE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: La patience des clients augmente de 30 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: FRET EXPRESS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: Les camions quittent les lieux 30 % plus vite.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "JOURN\xC9E BO\xCETE DOR\xC9E"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Chaque carton correctement livr\xE9 rapporte 30 % de plus. Apporte
      aussi 20 % de clients en plus, des d\xE9parts de camions 20 % plus rapides
      et un d\xE9placement 20 % plus rapide, mais l'endurance se r\xE9g\xE9n\xE8re
      20 % plus lentement."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "JOUR DE L'OPPORTUNIT\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Le co\xFBt des am\xE9liorations diminue de 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: JOUR DE QUOTA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: Tous les camions demandent une seule couleur de carton.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: SERVICE VIP
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: 10 % de chances que les cartons soient parfaits et rapportent 10
      % de plus.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: JOUR DE PLUIE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: 20 % de clients en moins arrivent.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: JOUR DE FESTIVAL
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Un bonus al\xE9atoire est obtenu au d\xE9but du jour."
    m_Metadata:
      m_Items: []
