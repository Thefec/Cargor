    m_Metadata:
      m_Items: []
  - m_Id: 4672235917193216
    m_Localized: "Top\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 4672275557560320
    m_Localized: Farba pleti
    m_Metadata:
      m_Items: []
  - m_Id: 4672388858294272
    m_Localized: "PREST\xCD\u017D"
    m_Metadata:
      m_Items: []
  - m_Id: 4672484777832448
    m_Localized: "\u010Eal\u0161\xED de\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 4672617426890752
    m_Localized: "Pokra\u010Dova\u0165"
    m_Metadata:
      m_Items: []
  - m_Id: 30567298710810624
    m_Localized: "Hos\u0165ova\u0165 hru"
    m_Metadata:
      m_Items: []
  - m_Id: 30567344864931840
    m_Localized: "Pripoji\u0165 sa k hre"
    m_Metadata:
      m_Items: []
  - m_Id: 30567847749398528
    m_Localized: "\u0160tart"
    m_Metadata:
      m_Items: []
  - m_Id: 30567978871730176
    m_Localized: Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 30568446771507200
    m_Localized: "Vybra\u0165 mapu\n(\u010Coskoro)"
    m_Metadata:
      m_Items: []
  - m_Id: 30568844051787776
    m_Localized: "Hlavn\xE1 kancel\xE1ria"
    m_Metadata:
      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: "Hra\u0165 online"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Hr\xE1\u010Di v lobby"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Spolu: {0} hr\xE1\u010Dov"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Stav oddychovej miestnosti
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Vn\xFAtri: {0} / {1} hr\xE1\u010Dov"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "V\u0161etci s\xFA pripraven\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "\u010Cak\xE1 sa na {0} hr\xE1\u010Dov..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Nena\u0161li sa \u017Eiadni hr\xE1\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Hr\xE1\u010D"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "N\xE1vod"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Iba hostite\u013E m\xF4\u017Ee vyhodi\u0165 hr\xE1\u010Dov!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Hr\xE1\u010D bol vyhoden\xFD!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: Vyhodenie zlyhalo!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Vo\u013En\xE9 miesto"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "De\u0148 {0}  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "De\u0148 skon\u010Dil. Cho\u010F do oddychovej miestnosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "De\u0148 n\xE1jomn\xE9ho"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "\xDArove\u0148: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Cena: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Max
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "K\xFApi\u0165"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Rad
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Zvy\u0161uje maxim\xE1lnu ve\u013Ekos\u0165 radu z\xE1kazn\xEDkov."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Vytrvalos\u0165"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Zvy\u0161uje r\xFDchlos\u0165 regener\xE1cie vytrvalosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Peniaze
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Zvy\u0161uje odmenu za doru\u010Den\xFA krabicu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Kami\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Odomyk\xE1 \u010Fal\u0161ie gar\xE1\u017Ee pre kami\xF3ny."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "\xDArove\u0148 \xFAlohy"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Odomyk\xE1 \xFAlohy vy\u0161\u0161ej \xFArovne."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "RU\u0160N\xDD DE\u0147"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "R\xFDchlos\u0165 pr\xEDchodu z\xE1kazn\xEDkov sa zvy\u0161uje o
      30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "NAHNEVAN\xCD Z\xC1KAZN\xCDCI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Trpezlivos\u0165 z\xE1kazn\xEDkov kles\xE1 o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "POMAL\xC1 LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kami\xF3ny op\xFA\u0161\u0165aj\xFA miesto o 50 % pomal\u0161ie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "\u0164A\u017DK\xC9 KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Celkov\xE1 r\xFDchlos\u0165 pohybu kles\xE1 o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBL\xC9M S \xDANAVOU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vytrvalos\u0165 sa obnovuje o 40 % pomal\u0161ie a r\xFDchlos\u0165
      \u0161printu kles\xE1 o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "PREKVAPIV\xC1 KONTROLA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "V\u0161etky chybn\xE9 oper\xE1cie s\xFA penalizovan\xE9 dvojn\xE1sobne."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "MARKETINGOV\xDD DE\u0147"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "O 20 % viac z\xE1kazn\xEDkov, ale o 30 % ni\u017E\u0161\xED zisk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "Z\xC1KAZN\xCDCKA PODPORA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Telef\xF3n na recepcii zvon\xED o 50 % \u010Dastej\u0161ie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS ZA DORU\u010CENIE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Z\xEDskaj o 20 % viac pe\u0148az\xED za doru\u010Denie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "POKOJN\xDD DE\u0147"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Trpezlivos\u0165 z\xE1kazn\xEDkov st\xFApa o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EXPRESN\xDD N\xC1KLAD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kami\xF3ny op\xFA\u0161\u0165aj\xFA miesto o 30 % r\xFDchlej\u0161ie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "DE\u0147 ZLATEJ KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Ka\u017Ed\xE1 spr\xE1vne doru\u010Den\xE1 krabica prin\xE1\u0161a
      o 30 % navy\u0161e. Prin\xE1\u0161a tie\u017E o 20 % viac z\xE1kazn\xEDkov,
      o 20 % r\xFDchlej\u0161ie odchody kami\xF3nov a o 20 % r\xFDchlej\u0161\xED
      pohyb, ale vytrvalos\u0165 sa obnovuje o 20 % pomal\u0161ie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "DE\u0147 PR\xCDLE\u017DITOST\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "N\xE1klady na vylep\u0161enia klesaj\xFA o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "DE\u0147 KV\xD3TY"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "V\u0161etky kami\xF3ny po\u017Eaduj\xFA iba jednu farbu krabice."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP SLU\u017DBA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10 % \u0161anca, \u017Ee krabica je perfektn\xE1 a zarob\xED o
      10 % viac."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "DA\u017DDIV\xDD DE\u0147"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Prich\xE1dza o 20 % menej z\xE1kazn\xEDkov."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "DE\u0147 FESTIVALU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Na za\u010Diatku d\u0148a je udelen\xFD n\xE1hodn\xFD bonus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Hr\xE1\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: ({0}/{1} v oddychovej miestnosti)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: "O\u010Dak\xE1van\xED z\xE1kazn\xEDci"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: "\u010Cerven\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000069
    m_Localized: "Modr\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000070
    m_Localized: "\u017Dlt\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000071
    m_Localized: "Zelen\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000072
    m_Localized: "\u017Diadna \xFAloha"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000073
    m_Localized: Odmena
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000074
    m_Localized: Postih
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000075
    m_Localized: "Dokon\u010Den\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000076
    m_Localized: Zlyhalo
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000077
    m_Localized: "Dokon\u010Di minihru {0}-kr\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000078
    m_Localized: "Umiestni {0} krab\xEDc na policu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000079
    m_Localized: "Umiestni {0} {1} krab\xEDc na policu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000080
    m_Localized: "Dokon\u010Di {0} kami\xF3nov"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000081
    m_Localized: "Obslu\u017E {0} z\xE1kazn\xEDkov"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000082
    m_Localized: "Ignoruj {0} z\xE1kazn\xEDkov"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000083
    m_Localized: "Zaba\u013E {0} hra\u010Diek"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000107
    m_Localized: "Dnes si u\u017E prijal \xFAlohu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000108
    m_Localized: "Prija\u0165"
    m_Metadata:
