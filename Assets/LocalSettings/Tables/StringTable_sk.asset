  - m_Id: 30569701396885504
    m_Localized: "Hrať online"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Hráči v lobby"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Spolu: {0} hráčov"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Stav oddychovej miestnosti"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Vnútri: {0} / {1} hráčov"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Všetci sú pripravení!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Čaká sa na {0} hráčov..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Nenašli sa žiadni hráči"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Hráč"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Návod"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Iba hostiteľ môže vyhodiť hráčov!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Hráč bol vyhodený!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Vyhodenie zlyhalo!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Voľné miesto"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "Deň {0}  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Deň skončil. Choď do oddychovej miestnosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Deň nájomného"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "Úroveň: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Cena: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: "Max"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "Kúpiť"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Rad"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Zvyšuje maximálnu veľkosť radu zákazníkov."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Vytrvalosť"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Zvyšuje rýchlosť regenerácie vytrvalosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Peniaze"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Zvyšuje odmenu za doručenú krabicu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Kamión"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Odomyká ďalšie garáže pre kamióny."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Úroveň úlohy"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Odomyká úlohy vyššej úrovne."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "RUŠNÝ DEŇ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Rýchlosť príchodu zákazníkov sa zvyšuje o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "NAHNEVANÍ ZÁKAZNÍCI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Trpezlivosť zákazníkov klesá o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "POMALÁ LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kamióny opúšťajú miesto o 50 % pomalšie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "ŤAŽKÉ KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Celková rýchlosť pohybu klesá o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBLÉM S ÚNAVOU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vytrvalosť sa obnovuje o 40 % pomalšie a rýchlosť šprintu klesá o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "PREKVAPIVÁ KONTROLA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Všetky chybné operácie sú penalizované dvojnásobne."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "MARKETINGOVÝ DEŇ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "O 20 % viac zákazníkov, ale o 30 % nižší zisk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "ZÁKAZNÍCKA PODPORA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Telefón na recepcii zvoní o 50 % častejšie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS ZA DORUČENIE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Získaj o 20 % viac peňazí za doručenie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "POKOJNÝ DEŇ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Trpezlivosť zákazníkov stúpa o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EXPRESNÝ NÁKLAD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kamióny opúšťajú miesto o 30 % rýchlejšie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "DEŇ ZLATEJ KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Každá správne doručená krabica prináša o 30 % navyše. Prináša tiež o 20 % viac zákazníkov, o 20 % rýchlejšie odchody kamiónov a o 20 % rýchlejší pohyb, ale vytrvalosť sa obnovuje o 20 % pomalšie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "DEŇ PRÍLEŽITOSTÍ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Náklady na vylepšenia klesajú o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "DEŇ KVÓTY"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Všetky kamióny požadujú iba jednu farbu krabice."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP SLUŽBA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10 % šanca, že krabica je perfektná a zarobí o 10 % viac."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "DAŽDIVÝ DEŇ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Prichádza o 20 % menej zákazníkov."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "DEŇ FESTIVALU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Na začiatku dňa je udelený náhodný bonus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Hráči"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: "({0}/{1} v oddychovej miestnosti)"
    m_Metadata:
