    m_Metadata:
      m_Items: []
  - m_Id: 30568844051787776
    m_Localized: Glavni ured
    m_Metadata:
      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: Igraj online
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Igra\u010Di u predsoblju"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Ukupno: {0} igra\u010Da"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Status sobe za odmor
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Unutra: {0} / {1} igra\u010Da"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: Svi su spremni!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "\u010Ceka se {0} igra\u010Da..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Nema prona\u0111enih igra\u010Da"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Igra\u010D"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Vodi\u010D"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Samo doma\u0107in mo\u017Ee izbaciti igra\u010De!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Igra\u010D izba\u010Den!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: Izbacivanje nije uspjelo!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: Prazno mjesto
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: Dan {0}  {1}:{2} ({3}s)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: Dan je gotov. Idi u sobu za odmor.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: Dan najma
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Razina: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Tro\u0161ak: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Maks
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Kupi
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Red \u010Dekanja"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Pove\u0107ava maksimalnu veli\u010Dinu reda kupaca."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Izdr\u017Eljivost"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Pove\u0107ava brzinu obnavljanja izdr\u017Eljivosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Novac
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Pove\u0107ava nagradu po dostavljenoj kutiji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Kamion
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Otklju\u010Dava dodatne hangare za kamione."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: Razina zadatka
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Otklju\u010Dava zadatke vi\u0161e razine."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "U\u017DURBAN DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: Stopa pojavljivanja kupaca raste za 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: LJUTI KUPCI
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: Strpljenje kupaca smanjuje se za 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: SPORA LOGISTIKA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kamioni napu\u0161taju mjesto 50% sporije."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "TE\u0160KE KUTIJE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: Ukupna brzina kretanja opada za 20%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: PROBLEM UMORA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Izdr\u017Eljivost se obnavlja 40% sporije, a brzina sprinta opada
      za 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: IZNENADNA REVIZIJA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Sve pogre\u0161ne radnje ka\u017Enjavaju se dvostruko."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: DAN MARKETINGA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% vi\u0161e kupaca, ali 30% manja zarada."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "KORISNI\u010CKA PODR\u0160KA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Telefon na recepciji zvoni 50% \u010De\u0161\u0107e."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: BONUS ZA DOSTAVU
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Zaradite 20% vi\u0161e novca po dostavi."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "OPU\u0160TEN DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: Strpljenje kupaca raste za 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: EKSPRESNI TERET
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kamioni napu\u0161taju mjesto 30% br\u017Ee."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: DAN ZLATNE KUTIJE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Svaka ispravno dostavljena kutija donosi dodatnih 30%. Tako\u0111er
      donosi 20% vi\u0161e kupaca, 20% br\u017Ee izlaske kamiona i 20% br\u017Ee
      kretanje, ali izdr\u017Eljivost se obnavlja 20% sporije."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: DAN PRILIKE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Tro\u0161kovi nadogradnje smanjuju se za 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: DAN KVOTE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Svi kamioni tra\u017Ee samo jednu boju kutije."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: VIP USLUGA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% \u0161anse da je kutija savr\u0161ena i donosi 10% vi\u0161e."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "KI\u0160NI DAN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: Dolazi 20% manje kupaca.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: DAN FESTIVALA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Nasumi\u010Dan bonus dobiva se na po\u010Detku dana."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Igra\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: ({0}/{1} u sobi za odmor)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: "O\u010Dekivani kupci"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: Crvena
    m_Metadata:
