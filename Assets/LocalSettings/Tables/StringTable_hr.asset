  - m_Id: 136808528593170434
    m_Localized: "<color=#4B4E6D>2</color>      Dobrodo\u0161li u Cargor!\n<color=#4B4E6D>3</color>     
      Osnovno kretanje\n<color=#4B4E6D>4</color>      Kako pakirati proizvode\n<color=#4B4E6D>5</color>     
      Slaganje na police\n<color=#4B4E6D>6</color>      Kamioni i dostava\n<color=#4B4E6D>7</color>      
      Kupci\n<line-height=18><color=#4B4E6D>8</color>      Posebni zahtjevi: povrati,\ndvostruke
      narud\u017Ebe, mje\u0161oviti kamioni</line-height>\n<color=#4B4E6D>9</color>     
      Najam i va\u0161 novac\n<color=#4B4E6D>10</color>   Nadogradnje\n<color=#4B4E6D>11</color>   
      Plo\u010Da zadataka\n<color=#4B4E6D>12</color>    Telefonska linija\n<color=#4B4E6D>13</color>   
      Soba za odmor i kraj dana\n<color=#4B4E6D>14</color>    Savjeti za timski rad"
    m_Metadata:
      m_Items: []
