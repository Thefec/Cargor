  - m_Id: 4671685976829952
    m_Localized: "\u0160ukuosenos"
    m_Metadata:
      m_Items: []
  - m_Id: 4671905867411456
    m_Localized: "Kepur\u0117s"
    m_Metadata:
      m_Items: []
  - m_Id: 4671966126977024
    m_Localized: "\u016Asai"
    m_Metadata:
      m_Items: []
  - m_Id: 4672063447412736
    m_Localized: "Vir\u0161utiniai drabu\u017Eiai"
    m_Metadata:
      m_Items: []
  - m_Id: 4672192313208832
    m_Localized: "Keln\u0117s"
    m_Metadata:
      m_Items: []
  - m_Id: 4672235917193216
    m_Localized: Batai
    m_Metadata:
      m_Items: []
  - m_Id: 4672275557560320
    m_Localized: Odos spalva
    m_Metadata:
      m_Items: []
  - m_Id: 4672388858294272
    m_Localized: "PRESTI\u017DAS"
    m_Metadata:
      m_Items: []
  - m_Id: 4672484777832448
    m_Localized: Kita diena
    m_Metadata:
      m_Items: []
  - m_Id: 4672617426890752
    m_Localized: "T\u0119sti"
    m_Metadata:
      m_Items: []
  - m_Id: 30567298710810624
    m_Localized: "Sukurti \u017Eaidim\u0105"
    m_Metadata:
      m_Items: []
  - m_Id: 30567344864931840
    m_Localized: "Prisijungti prie \u017Eaidimo"
    m_Metadata:
      m_Items: []
  - m_Id: 30567847749398528
    m_Localized: "Prad\u0117ti"
    m_Metadata:
      m_Items: []
  - m_Id: 30567978871730176
    m_Localized: Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 30568446771507200
    m_Localized: "Pasirinkti \u017Eem\u0117lap\u012F\n(Netrukus)"
    m_Metadata:
      m_Items: []
  - m_Id: 30568844051787776
    m_Localized: Pagrindinis biuras
    m_Metadata:
      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: "\u017Daisti internetu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "\u017Daid\u0117jai vestibiulyje"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "I\u0161 viso: {0} \u017Eaid\u0117j\u0173"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Poilsio kambario b\u016Bsena"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Viduje: {0} / {1} \u017Eaid\u0117j\u0173"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Visi pasiruo\u0161\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Laukiama {0} \u017Eaid\u0117j\u0173..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "\u017Daid\u0117j\u0173 nerasta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "\u017Daid\u0117jas"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: Mokymas
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Tik \u017Eaidimo \u0161eimininkas gali pa\u0161alinti \u017Eaid\u0117jus!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "\u017Daid\u0117jas pa\u0161alintas!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Pa\u0161alinti nepavyko!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: Laisva vieta
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: '{0} diena  {1}:{2} ({3}s)'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Diena baig\u0117si. Eik \u012F poilsio kambar\u012F."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: Nuomos diena
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Lygis: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Kaina: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Maks
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Pirkti
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Eil\u0117"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Padidina maksimal\u0173 klient\u0173 eil\u0117s dyd\u012F."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "I\u0161tverm\u0117"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Padidina i\u0161tverm\u0117s atsigavimo greit\u012F."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Pinigai
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Padidina atlyg\u012F u\u017E kiekvien\u0105 pristatyt\u0105 d\u0117\u017E\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Sunkve\u017Eimis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Atrakina papildomus sunkve\u017Eimi\u0173 angarus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "U\u017Eduoties lygis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Atrakina auk\u0161tesnio lygio u\u017Eduotis."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "\u012ETEMPTA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Klient\u0173 atvykimo greitis padid\u0117ja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: PIKTI KLIENTAI
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Klient\u0173 kantryb\u0117 suma\u017E\u0117ja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "L\u0116TA LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Sunkve\u017Eimiai palieka viet\u0105 50% l\u0117\u010Diau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "SUNKIOS D\u0116\u017D\u0116S"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Bendras jud\u0117jimo greitis suma\u017E\u0117ja 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: NUOVARGIO PROBLEMA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "I\u0161tverm\u0117 atsistato 40% l\u0117\u010Diau, o sprinto greitis
      suma\u017E\u0117ja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "NETIK\u0116TAS PATIKRINIMAS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Visos klaidingos operacijos baud\u017Eiamos dvigubai."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: RINKODAROS DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% daugiau klient\u0173, bet 30% ma\u017Eiau pajam\u0173."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "KLIENT\u0172 APTARNAVIMAS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Registrat\u016Bros telefonas skambina 50% da\u017Eniau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: PRISTATYMO PREMIJA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "U\u017Edirbk 20% daugiau pinig\u0173 u\u017E pristatym\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: RAMI DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Klient\u0173 kantryb\u0117 padid\u0117ja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: EKSPRESO KROVINYS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Sunkve\u017Eimiai palieka viet\u0105 30% grei\u010Diau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "AUKSIN\u0116S D\u0116\u017D\u0116S DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Kiekviena teisingai pristatyta d\u0117\u017E\u0117 duoda papildomus
      30%. Taip pat atne\u0161a 20% daugiau klient\u0173, 20% greitesn\u012F sunkve\u017Eimi\u0173
      i\u0161vykim\u0105 ir 20% greitesn\u012F jud\u0117jim\u0105, bet i\u0161tverm\u0117
      atsistato 20% l\u0117\u010Diau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "GALIMYBI\u0172 DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Patobulinim\u0173 kaina suma\u017E\u0117ja 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: KVOTOS DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Visi sunkve\u017Eimiai pra\u0161o tik vienos d\u0117\u017E\u0117s
      spalvos."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: VIP PASLAUGA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% tikimyb\u0117, kad d\u0117\u017E\u0117 yra tobula ir duoda
      10% daugiau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: LIETINGA DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Atvyksta 20% ma\u017Eiau klient\u0173."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: FESTIVALIO DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Dienos prad\u017Eioje gaunamas atsitiktinis premijos priedas."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "\u017Daid\u0117jai"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: ({0}/{1} poilsio kambaryje)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: Laukiami klientai
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: Raudona
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000069
    m_Localized: "M\u0117lyna"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000070
    m_Localized: Geltona
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000071
    m_Localized: "\u017Dalia"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000072
    m_Localized: "N\u0117ra u\u017Eduoties"
    m_Metadata:
      m_Items: []
