      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: "Žaisti internetu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Žaidėjai vestibiulyje"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Iš viso: {0} žaidėjų"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Poilsio kambario būsena"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Viduje: {0} / {1} žaidėjų"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Visi pasiruošę!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Laukiama {0} žaidėjų..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Žaidėjų nerasta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Žaidėjas"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Mokymas"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Tik žaidimo šeimininkas gali pašalinti žaidėjus!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Žaidėjas pašalintas!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Pašalinti nepavyko!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Laisva vieta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "{0} diena  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Diena baigėsi. Eik į poilsio kambarį."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Nuomos diena"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "Lygis: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Kaina: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: "Maks"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "Pirkti"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Eilė"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Padidina maksimalų klientų eilės dydį."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Ištvermė"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Padidina ištvermės atsigavimo greitį."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Pinigai"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Padidina atlygį už kiekvieną pristatytą dėžę."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Sunkvežimis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Atrakina papildomus sunkvežimių angarus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Užduoties lygis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Atrakina aukštesnio lygio užduotis."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "ĮTEMPTA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Klientų atvykimo greitis padidėja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "PIKTI KLIENTAI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Klientų kantrybė sumažėja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "LĖTA LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Sunkvežimiai palieka vietą 50% lėčiau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "SUNKIOS DĖŽĖS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Bendras judėjimo greitis sumažėja 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "NUOVARGIO PROBLEMA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Ištvermė atsistato 40% lėčiau, o sprinto greitis sumažėja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "NETIKĖTAS PATIKRINIMAS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Visos klaidingos operacijos baudžiamos dvigubai."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "RINKODAROS DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% daugiau klientų, bet 30% mažiau pajamų."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "KLIENTŲ APTARNAVIMAS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Registratūros telefonas skambina 50% dažniau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "PRISTATYMO PREMIJA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Uždirbk 20% daugiau pinigų už pristatymą."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "RAMI DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Klientų kantrybė padidėja 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EKSPRESO KROVINYS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Sunkvežimiai palieka vietą 30% greičiau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "AUKSINĖS DĖŽĖS DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Kiekviena teisingai pristatyta dėžė duoda papildomus 30%. Taip pat atneša 20% daugiau klientų, 20% greitesnį sunkvežimių išvykimą ir 20% greitesnį judėjimą, bet ištvermė atsistato 20% lėčiau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "GALIMYBIŲ DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Patobulinimų kaina sumažėja 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "KVOTOS DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Visi sunkvežimiai prašo tik vienos dėžės spalvos."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP PASLAUGA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% tikimybė, kad dėžė yra tobula ir duoda 10% daugiau."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "LIETINGA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Atvyksta 20% mažiau klientų."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "FESTIVALIO DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Dienos pradžioje gaunamas atsitiktinis premijos priedas."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Žaidėjai"
    m_Metadata:
      m_Items: []
