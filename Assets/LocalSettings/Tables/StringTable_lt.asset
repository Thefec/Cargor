      m_Items: []
  - m_Id: 136808528593170434
    m_Localized: "<color=#4B4E6D>2</color>      Sveiki atvyk\u0119 \u012F Cargor!\n<color=#4B4E6D>3</color>     
      Pagrindinis jud\u0117jimas\n<color=#4B4E6D>4</color>      Kaip supakuoti prekes\n<color=#4B4E6D>5</color>     
      Preki\u0173 d\u0117jimas \u012F lentynas\n<color=#4B4E6D>6</color>      Sunkve\u017Eimiai
      ir pristatymas\n<color=#4B4E6D>7</color>       Klientai\n<line-height=18><color=#4B4E6D>8</color>     
      Special\u016Bs pra\u0161ymai: gr\u0105\u017Einimai,\ndvigubi u\u017Esakymai,
      mi\u0161r\u016Bs sunkve\u017Eimiai</line-height>\n<color=#4B4E6D>9</color>     
      Nuoma ir j\u016Bs\u0173 pinigai\n<color=#4B4E6D>10</color>   Patobulinimai\n<color=#4B4E6D>11</color>   
      U\u017Eduo\u010Di\u0173 lenta\n<color=#4B4E6D>12</color>    Telefono linija\n<color=#4B4E6D>13</color>   
      Poilsio kambarys ir dienos pabaiga\n<color=#4B4E6D>14</color>    Komandinio
      darbo patarimai"
    m_Metadata:
      m_Items: []
