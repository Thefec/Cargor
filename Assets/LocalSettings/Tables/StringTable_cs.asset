    m_Metadata:
      m_Items: []
  - m_Id: 30567978871730176
    m_Localized: Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 30568446771507200
    m_Localized: "Vybrat mapu\n(Ji\u017E brzy)"
    m_Metadata:
      m_Items: []
  - m_Id: 30568844051787776
    m_Localized: "Hlavn\xED kancel\xE1\u0159"
    m_Metadata:
      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: "Hr\xE1t online"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Hr\xE1\u010Di v lobby"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Celkem: {0} hr\xE1\u010D\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Stav odpo\u010Dinkov\xE9 m\xEDstnosti"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Uvnit\u0159: {0} / {1} hr\xE1\u010D\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "V\u0161ichni jsou p\u0159ipraveni!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "\u010Cek\xE1 se na {0} hr\xE1\u010D\u016F..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Nebyli nalezeni \u017E\xE1dn\xED hr\xE1\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Hr\xE1\u010D"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "V\xFDukov\xFD program"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Pouze hostitel m\u016F\u017Ee vyhazovat hr\xE1\u010De!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Hr\xE1\u010D byl vyhozen!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Vyhozen\xED se nezda\u0159ilo!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Voln\xE9 m\xEDsto"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: Den {0}  {1}:{2} ({3}s)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Den skon\u010Dil. Jdi do odpo\u010Dinkov\xE9 m\xEDstnosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Den n\xE1jmu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "\xDArove\u0148: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Cena: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Max
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Koupit
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Fronta
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Zvy\u0161uje maxim\xE1ln\xED velikost fronty z\xE1kazn\xEDk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: Vytrvalost
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Zvy\u0161uje rychlost regenerace vytrvalosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Pen\xEDze"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Zvy\u0161uje odm\u011Bnu za doru\u010Denou krabici."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Kamion
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Odemyk\xE1 dal\u0161\xED gar\xE1\u017Ee pro kamiony."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "\xDArove\u0148 \xFAkolu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Odemyk\xE1 \xFAkoly vy\u0161\u0161\xED \xFArovn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "RU\u0160N\xDD DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Rychlost p\u0159\xEDchodu z\xE1kazn\xEDk\u016F se zvy\u0161uje
      o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "NA\u0160TVAN\xCD Z\xC1KAZN\xCDCI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Trp\u011Blivost z\xE1kazn\xEDk\u016F kles\xE1 o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "POMAL\xC1 LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kamiony opou\u0161t\u011Bj\xED m\xEDsto o 50 % pomaleji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "T\u011A\u017DK\xC9 KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Celkov\xE1 rychlost pohybu kles\xE1 o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBL\xC9M S \xDANAVOU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vytrvalost se obnovuje o 40 % pomaleji a rychlost sprintu kles\xE1
      o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "P\u0158EKVAPIV\xC1 KONTROLA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "V\u0161echny chybn\xE9 operace jsou penalizov\xE1ny dvojn\xE1sobn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "MARKETINGOV\xDD DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "O 20 % v\xEDce z\xE1kazn\xEDk\u016F, ale o 30 % ni\u017E\u0161\xED
      zisk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "Z\xC1KAZNICK\xC1 PODPORA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Telefon na recepci zvon\xED o 50 % \u010Dast\u011Bji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS ZA DORU\u010CEN\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Z\xEDskej o 20 % v\xEDce pen\u011Bz za doru\u010Den\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "KLIDN\xDD DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Trp\u011Blivost z\xE1kazn\xEDk\u016F stoup\xE1 o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EXPRESN\xCD N\xC1KLAD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kamiony opou\u0161t\u011Bj\xED m\xEDsto o 30 % rychleji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "DEN ZLAT\xC9 KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Ka\u017Ed\xE1 spr\xE1vn\u011B doru\u010Den\xE1 krabice p\u0159in\xE1\u0161\xED
      o 30 % nav\xEDc. P\u0159in\xE1\u0161\xED tak\xE9 o 20 % v\xEDce z\xE1kazn\xEDk\u016F,
      o 20 % rychlej\u0161\xED odjezdy kamion\u016F a o 20 % rychlej\u0161\xED pohyb,
      ale vytrvalost se obnovuje o 20 % pomaleji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "DEN P\u0158\xCDLE\u017DITOST\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "N\xE1klady na vylep\u0161en\xED klesaj\xED o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "DEN KV\xD3TY"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "V\u0161echny kamiony po\u017Eaduj\xED pouze jednu barvu krabice."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP SLU\u017DBA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% \u0161ance, \u017Ee krabice je perfektn\xED a vyd\u011Bl\xE1
      o 10 % v\xEDce."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "DE\u0160TIV\xDD DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "P\u0159ich\xE1z\xED o 20 % m\xE9n\u011B z\xE1kazn\xEDk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: DEN FESTIVALU
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Na za\u010D\xE1tku dne je ud\u011Blen n\xE1hodn\xFD bonus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Hr\xE1\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: "({0}/{1} v odpo\u010Dinkov\xE9 m\xEDstnosti)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: "O\u010Dek\xE1van\xED z\xE1kazn\xEDci"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: "\u010Cerven\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000069
    m_Localized: "Modr\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000070
    m_Localized: "\u017Dlut\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000071
    m_Localized: "Zelen\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000072
    m_Localized: "\u017D\xE1dn\xFD \xFAkol"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000073
    m_Localized: "Odm\u011Bna"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000074
    m_Localized: Postih
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000075
    m_Localized: "Dokon\u010Deno"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000076
    m_Localized: Selhalo
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000077
    m_Localized: "Dokon\u010Di minihru {0}kr\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000078
    m_Localized: "Um\xEDsti {0} krabic na polici"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000079
    m_Localized: "Um\xEDsti {0} {1} krabic na polici"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000080
    m_Localized: "Dokon\u010Di {0} kamion\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000081
    m_Localized: "Obslu\u017E {0} z\xE1kazn\xEDk\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000082
    m_Localized: "Ignoruj {0} z\xE1kazn\xEDk\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000083
    m_Localized: "Zabal {0} hra\u010Dek"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000107
    m_Localized: "Dnes jsi ji\u017E p\u0159ijal \xFAkol"
