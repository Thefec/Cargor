  - m_Id: 30570000000000001
    m_Localized: "Hráči v lobby"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Celkem: {0} hráčů"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Stav odpočinkové místnosti"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Uvnitř: {0} / {1} hráčů"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Všichni jsou připraveni!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Čeká se na {0} hráčů..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Nebyli nalezeni žádní hráči"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Hráč"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Výukový program"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Pouze hostitel může vyhazovat hráče!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Hráč byl vyhozen!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Vyhození se nezdařilo!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Volné místo"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "Den {0}  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Den skončil. Jdi do odpočinkové místnosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Den nájmu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "Úroveň: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Cena: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: "Max"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "Koupit"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Fronta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Zvyšuje maximální velikost fronty zákazníků."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Vytrvalost"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Zvyšuje rychlost regenerace vytrvalosti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Peníze"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Zvyšuje odměnu za doručenou krabici."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Kamion"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Odemyká další garáže pro kamiony."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Úroveň úkolu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Odemyká úkoly vyšší úrovně."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "RUŠNÝ DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Rychlost příchodu zákazníků se zvyšuje o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "NAŠTVANÍ ZÁKAZNÍCI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Trpělivost zákazníků klesá o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "POMALÁ LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kamiony opouštějí místo o 50 % pomaleji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "TĚŽKÉ KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Celková rychlost pohybu klesá o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBLÉM S ÚNAVOU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vytrvalost se obnovuje o 40 % pomaleji a rychlost sprintu klesá o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "PŘEKVAPIVÁ KONTROLA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Všechny chybné operace jsou penalizovány dvojnásobně."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "MARKETINGOVÝ DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "O 20 % více zákazníků, ale o 30 % nižší zisk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "ZÁKAZNICKÁ PODPORA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Telefon na recepci zvoní o 50 % častěji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS ZA DORUČENÍ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Získej o 20 % více peněz za doručení."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "KLIDNÝ DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Trpělivost zákazníků stoupá o 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EXPRESNÍ NÁKLAD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kamiony opouštějí místo o 30 % rychleji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "DEN ZLATÉ KRABICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Každá správně doručená krabice přináší o 30 % navíc. Přináší také o 20 % více zákazníků, o 20 % rychlejší odjezdy kamionů a o 20 % rychlejší pohyb, ale vytrvalost se obnovuje o 20 % pomaleji."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "DEN PŘÍLEŽITOSTÍ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Náklady na vylepšení klesají o 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "DEN KVÓTY"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Všechny kamiony požadují pouze jednu barvu krabice."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP SLUŽBA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% šance, že krabice je perfektní a vydělá o 10 % více."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "DEŠTIVÝ DEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Přichází o 20 % méně zákazníků."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "DEN FESTIVALU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Na začátku dne je udělen náhodný bonus."
    m_Metadata:
      m_Items: []
