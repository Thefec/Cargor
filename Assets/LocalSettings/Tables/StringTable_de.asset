    m_Localized: "Kaufen"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Warteschlange"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Erhöht die maximale Größe der Kundenwarteschlange."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Ausdauer"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Erhöht die Ausdauerregeneration."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Geld"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Erhöht die Belohnung pro gelieferter Kiste."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "LKW"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Schaltet zusätzliche LKW-Hallen frei."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Auftragsstufe"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Schaltet höherstufige Aufträge frei."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "GESCHÄFTIGER TAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Die Kundenspawnrate steigt um 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "WÜTENDE KUNDEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Die Geduld der Kunden sinkt um 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "LANGSAME LOGISTIK"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "LKW verlassen die Szene 50 % langsamer."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "SCHWERE KISTEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Die Bewegungsgeschwindigkeit sinkt insgesamt um 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "ERMÜDUNGSPROBLEM"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Ausdauer regeneriert 40 % langsamer und die Sprintgeschwindigkeit sinkt um 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "ÜBERRASCHUNGSPRÜFUNG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Alle fehlerhaften Vorgänge werden doppelt bestraft."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "MARKETINGTAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20 % mehr Kunden, aber 30 % weniger Einnahmen."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "KUNDENDIENST"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Das Empfangstelefon klingelt 50 % häufiger."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "LIEFERBONUS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Verdiene 20 % mehr Geld pro Lieferung."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "ENTSPANNTER TAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Die Geduld der Kunden steigt um 30 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EXPRESS-FRACHT"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "LKW verlassen die Szene 30 % schneller."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "GOLDENE-KISTE-TAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Jede korrekt gelieferte Kiste bringt zusätzlich 30 %. Außerdem 20 % mehr Kunden, 20 % schnellere LKW-Abfahrten und 20 % schnellere Bewegung, aber die Ausdauer regeneriert 20 % langsamer."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "TAG DER GELEGENHEIT"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Upgrade-Kosten sinken um 20 %."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "QUOTENTAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Alle LKW fordern nur eine Kistenfarbe an."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP-SERVICE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10 % Chance, dass Kisten perfekt sind und 10 % mehr einbringen."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "REGENTAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "20 % weniger Kunden kommen."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
