  - m_Id: 30570000000000009
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: Nur der Host kann Spieler entfernen!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: Spieler entfernt!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: Entfernen fehlgeschlagen!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: Freier Platz
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: Tag {0}  {1}:{2} ({3}s)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: Tag vorbei. Geh zum Pausenraum.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: Miettag
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Stufe: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Kosten: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Max
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Kaufen
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Warteschlange
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Erh\xF6ht die maximale Gr\xF6\xDFe der Kundenwarteschlange."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: Ausdauer
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Erh\xF6ht die Ausdauerregeneration."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Geld
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Erh\xF6ht die Belohnung pro gelieferter Kiste."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: LKW
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Schaltet zus\xE4tzliche LKW-Hallen frei."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: Auftragsstufe
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Schaltet h\xF6herstufige Auftr\xE4ge frei."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "GESCH\xC4FTIGER TAG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: Die Kundenspawnrate steigt um 30 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "W\xDCTENDE KUNDEN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: Die Geduld der Kunden sinkt um 30 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: LANGSAME LOGISTIK
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: LKW verlassen die Szene 50 % langsamer.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: SCHWERE KISTEN
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: Die Bewegungsgeschwindigkeit sinkt insgesamt um 20 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "ERM\xDCDUNGSPROBLEM"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: Ausdauer regeneriert 40 % langsamer und die Sprintgeschwindigkeit
      sinkt um 30 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "\xDCBERRASCHUNGSPR\xDCFUNG"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Alle fehlerhaften Vorg\xE4nge werden doppelt bestraft."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: MARKETINGTAG
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: 20 % mehr Kunden, aber 30 % weniger Einnahmen.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: KUNDENDIENST
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Das Empfangstelefon klingelt 50 % h\xE4ufiger."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: LIEFERBONUS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: Verdiene 20 % mehr Geld pro Lieferung.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: ENTSPANNTER TAG
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: Die Geduld der Kunden steigt um 30 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: EXPRESS-FRACHT
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: LKW verlassen die Szene 30 % schneller.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: GOLDENE-KISTE-TAG
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Jede korrekt gelieferte Kiste bringt zus\xE4tzlich 30 %. Au\xDFerdem
      20 % mehr Kunden, 20 % schnellere LKW-Abfahrten und 20 % schnellere Bewegung,
      aber die Ausdauer regeneriert 20 % langsamer."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: TAG DER GELEGENHEIT
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: Upgrade-Kosten sinken um 20 %.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: QUOTENTAG
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: Alle LKW fordern nur eine Kistenfarbe an.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: VIP-SERVICE
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: 10 % Chance, dass Kisten perfekt sind und 10 % mehr einbringen.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: REGENTAG
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: 20 % weniger Kunden kommen.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: FESTIVALTAG
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Zuf\xE4lliger Bonus zu Tagesbeginn."
    m_Metadata:
      m_Items: []
