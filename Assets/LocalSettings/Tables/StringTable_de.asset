    m_Localized: "<color=#4B4E6D>2</color>      Willkommen bei Cargor!\n<color=#4B4E6D>3</color>     
      Grundlegende Bewegung\n<color=#4B4E6D>4</color>      Wie man Produkte verpackt\n<color=#4B4E6D>5</color>     
      Regale einr\xE4umen\n<color=#4B4E6D>6</color>      Lkws und Lieferung\n<color=#4B4E6D>7</color>      
      Kunden\n<line-height=18><color=#4B4E6D>8</color>      Sonderw\xFCnsche: R\xFCckgaben,\nDoppelbestellungen,
      gemischte Lkws</line-height>\n<color=#4B4E6D>9</color>      Miete und Ihr Geld\n<color=#4B4E6D>10</color>  
      Verbesserungen\n<color=#4B4E6D>11</color>    Aufgabenbrett\n<color=#4B4E6D>12</color>   
      Telefonleitung\n<color=#4B4E6D>13</color>    Pausenraum und Tagesende\n<color=#4B4E6D>14</color>   
      Tipps zur Teamarbeit"
    m_Metadata:
