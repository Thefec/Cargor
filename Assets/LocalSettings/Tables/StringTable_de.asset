  - m_Id: 144849164114263132
    m_Localized: "Lobby konnte nicht erstellt werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263133
    m_Localized: "Beitritt zur Lobby fehlgeschlagen!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263134
    m_Localized: "Verbindungsfehler!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263135
    m_Localized: "Netzwerkfehler!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263136
    m_Localized: "Host konnte nicht gestartet werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263137
    m_Localized: "Host-Fehler!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263138
    m_Localized: "Verbindung fehlgeschlagen!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263139
    m_Localized: "Ung\xFCltige Lobby!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263140
    m_Localized: "Lobby-Fehler!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263141
    m_Localized: "Ein unerwarteter Fehler ist aufgetreten!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263142
    m_Localized: "Bitte gib einen Lobby-Code ein!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263143
    m_Localized: "Ung\xFCltiger Lobby-Code!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263144
    m_Localized: "Keine g\xFCltige Lobby!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263145
    m_Localized: "Lobby konnte nicht \xFCberpr\xFCft werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263146
    m_Localized: "Du musst zuerst eine Lobby erstellen!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263147
    m_Localized: "Steam-Einladungsmen\xFC konnte nicht ge\xF6ffnet werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263148
    m_Localized: "Nur der Host kann das Spiel starten!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263149
    m_Localized: "Netzwerk ist nicht bereit!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263150
    m_Localized: "Szene konnte nicht geladen werden!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263151
    m_Localized: "Lobby existiert nicht!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263152
    m_Localized: "Du darfst dieser Lobby nicht beitreten!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263153
    m_Localized: "Lobby ist voll!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263154
    m_Localized: "Du wurdest aus dieser Lobby gebannt!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263155
    m_Localized: "Dein Konto ist eingeschr\xE4nkt!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263156
    m_Localized: "Clan ist deaktiviert!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263157
    m_Localized: "Du hast eine Community-Sperre!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263158
    m_Localized: "Beitritt fehlgeschlagen: {0}"
    m_Metadata:
