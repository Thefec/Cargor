  - m_Id: 30569701396885504
    m_Localized: "M\xE4ngi internetis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "M\xE4ngijad ooteruumis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Kokku: {0} m\xE4ngijat"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Puhkeruumi olek
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Sees: {0} / {1} m\xE4ngijat"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "K\xF5ik on valmis!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Oodatakse {0} m\xE4ngijat..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "M\xE4ngijaid ei leitud"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "M\xE4ngija"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "\xD5petus"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Ainult m\xE4ngu looja saab m\xE4ngijaid eemaldada!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "M\xE4ngija eemaldatud!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Eemaldamine eba\xF5nnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "T\xFChi koht"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "{0}. p\xE4ev  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "P\xE4ev on l\xE4bi. Mine puhkeruumi."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "\xDC\xFCrip\xE4ev"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Tase: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Hind: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Maks
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Osta
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "J\xE4rjekord"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Suurendab klientide j\xE4rjekorra maksimumsuurust."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: Vastupidavus
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: Suurendab vastupidavuse taastumise kiirust.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Raha
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: Suurendab tasu iga kohaletoimetatud kasti eest.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Veoauto
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: Avab lisaveoautode angaarid.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "\xDClesande tase"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Avab k\xF5rgema taseme \xFClesanded."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "KIIRE P\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: Klientide ilmumise kiirus suureneb 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: VIHASED KLIENDID
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Klientide kannatlikkus v\xE4heneb 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: AEGLANE LOGISTIKA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: Veoautod lahkuvad kohalt 50% aeglasemalt.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: RASKED KASTID
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "\xDCldine liikumiskiirus v\xE4heneb 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "V\xC4SIMUSE PROBLEEM"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vastupidavus taastub 40% aeglasemalt ja sprindikiirus v\xE4heneb
      30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "\xDCLLATUSKONTROLL"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "K\xF5iki vigaseid toiminguid karistatakse topelt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "TURUNDUSP\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% rohkem kliente, kuid 30% v\xE4iksem tulu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: KLIENDITUGI
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Vastuv\xF5tu telefon heliseb 50% sagedamini."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: KOHALETOIMETAMISE BOONUS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: Teeni 20% rohkem raha iga kohaletoimetamise eest.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "RAHULIK P\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: Klientide kannatlikkus suureneb 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: EKSPRESSKAUP
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: Veoautod lahkuvad kohalt 30% kiiremini.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "KULDKASTI P\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Iga \xF5igesti kohale toimetatud kast annab lisaks 30%. Toob ka
      20% rohkem kliente, 20% kiiremad veoautode v\xE4ljumised ja 20% kiirema liikumise,
      kuid vastupidavus taastub 20% aeglasemalt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "V\xD5IMALUSTE P\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Uuenduste hind v\xE4heneb 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "KVOODIP\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "K\xF5ik veoautod n\xF5uavad ainult \xFChte kasti v\xE4rvi."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: VIP TEENUS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% v\xF5imalus, et kast on t\xE4iuslik ja annab 10% rohkem."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "VIHMANE P\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Saabub 20% v\xE4hem kliente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "FESTIVALIP\xC4EV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "P\xE4eva alguses saadakse juhuslik boonus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "M\xE4ngijad"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: ({0}/{1} puhkeruumis)
    m_Metadata:
      m_Items: []
