  - m_Id: 30569701396885504
    m_Localized: "Mängi internetis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Mängijad ooteruumis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Kokku: {0} mängijat"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Puhkeruumi olek"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Sees: {0} / {1} mängijat"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Kõik on valmis!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Oodatakse {0} mängijat..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Mängijaid ei leitud"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Mängija"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Õpetus"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Ainult mängu looja saab mängijaid eemaldada!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Mängija eemaldatud!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Eemaldamine ebaõnnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Tühi koht"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "{0}. päev  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Päev on läbi. Mine puhkeruumi."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Üüripäev"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "Tase: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Hind: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: "Maks"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "Osta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Järjekord"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Suurendab klientide järjekorra maksimumsuurust."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Vastupidavus"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Suurendab vastupidavuse taastumise kiirust."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Raha"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Suurendab tasu iga kohaletoimetatud kasti eest."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Veoauto"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Avab lisaveoautode angaarid."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Ülesande tase"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Avab kõrgema taseme ülesanded."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "KIIRE PÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Klientide ilmumise kiirus suureneb 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "VIHASED KLIENDID"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Klientide kannatlikkus väheneb 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "AEGLANE LOGISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Veoautod lahkuvad kohalt 50% aeglasemalt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "RASKED KASTID"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Üldine liikumiskiirus väheneb 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "VÄSIMUSE PROBLEEM"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Vastupidavus taastub 40% aeglasemalt ja sprindikiirus väheneb 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "ÜLLATUSKONTROLL"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Kõiki vigaseid toiminguid karistatakse topelt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "TURUNDUSPÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% rohkem kliente, kuid 30% väiksem tulu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "KLIENDITUGI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Vastuvõtu telefon heliseb 50% sagedamini."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "KOHALETOIMETAMISE BOONUS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Teeni 20% rohkem raha iga kohaletoimetamise eest."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "RAHULIK PÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Klientide kannatlikkus suureneb 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EKSPRESSKAUP"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Veoautod lahkuvad kohalt 30% kiiremini."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "KULDKASTI PÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Iga õigesti kohale toimetatud kast annab lisaks 30%. Toob ka 20% rohkem kliente, 20% kiiremad veoautode väljumised ja 20% kiirema liikumise, kuid vastupidavus taastub 20% aeglasemalt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "VÕIMALUSTE PÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Uuenduste hind väheneb 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "KVOODIPÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Kõik veoautod nõuavad ainult ühte kasti värvi."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP TEENUS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% võimalus, et kast on täiuslik ja annab 10% rohkem."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "VIHMANE PÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Saabub 20% vähem kliente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "FESTIVALIPÄEV"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Päeva alguses saadakse juhuslik boonus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Mängijad"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: "({0}/{1} puhkeruumis)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: "Oodatavad kliendid"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: "Punane"
    m_Metadata:
