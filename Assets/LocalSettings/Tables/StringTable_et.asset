  - m_Id: 136808528593170434
    m_Localized: "<color=#4B4E6D>2</color>      Tere tulemast Cargorisse!\n<color=#4B4E6D>3</color>     
      P\xF5hiliikumine\n<color=#4B4E6D>4</color>      Kuidas tooteid pakendada\n<color=#4B4E6D>5</color>     
      Riiulile paigutamine\n<color=#4B4E6D>6</color>      Veokid ja tarne\n<color=#4B4E6D>7</color>      
      Kliendid\n<line-height=18><color=#4B4E6D>8</color>      Erisoovid: tagastused,\ntopelttellimused,
      segaveokid</line-height>\n<color=#4B4E6D>9</color>      \xDC\xFCr ja teie raha\n<color=#4B4E6D>10</color>  
      T\xE4iustused\n<color=#4B4E6D>11</color>    \xDClesannete tahvel\n<color=#4B4E6D>12</color>   
      Telefoniliin\n<color=#4B4E6D>13</color>    Puhkeruum ja p\xE4eva l\xF5pp\n<color=#4B4E6D>14</color>   
      Meeskonnat\xF6\xF6 n\xF5uanded"
    m_Metadata:
      m_Items: []
