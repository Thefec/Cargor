      m_Items: []
  - m_Id: 136808528651890688
    m_Localized: ESM
    m_Metadata:
      m_Items: []
  - m_Id: 136808528651890689
    m_Localized: Raha
    m_Metadata:
      m_Items: []
  - m_Id: 137269394388168704
    m_Localized: "<b> T\xE4helepanu: </b> T\xE4helepanu: kui kasti v\xE4rv ei \xFChti
      tootega, pakkimine eba\xF5nnestub ja kast puruneb sul k\xE4es. Kontrolli v\xE4rvi
      enne pakkimist \u2014 \xE4ra raiska kasti."
    m_Metadata:
      m_Items: []
  - m_Id: 137269394430111744
    m_Localized: "<b> Vihje: </b>Viskamine ja p\xFC\xFCdmine s\xE4\xE4stab aega kahe
      inimese jaamas, aga \xE4ra tee sellest harjumust \u2014 iga mahakukkumine l\xE4heb
      sulle maksma."
    m_Metadata:
      m_Items: []
  - m_Id: 137269605470711808
    m_Localized: "RIIULITE T\xC4ITMINE"
    m_Metadata:
      m_Items: []
  - m_Id: 137269605474906112
    m_Localized: "Riiulid on Cargori elut\xE4htis osa. Kolm t\xFC\xFCpi t\xFChje
      kaste \u2014 punane, kollane ja sinine \u2014 ootavad seal alati; kui v\xF5tad
      \xFChe, t\xE4ieneb riiul peagi uuesti, seega ei j\xE4\xE4 see kunagi t\xE4iesti
      t\xFChjaks. Kui sul on \xFCleliigne kast v\xF5i pakitud toode, mida sa hetkel
      kaasas kanda ei taha, v\xF5id selle riiulisse tagasi panna. Korras riiul lihtsustab
      t\xF6\xF6d nii sulle kui su meeskonnale \u2014 k\xF5ik teavad, kust mida leida."
    m_Metadata:
      m_Items: []
  - m_Id: 137269605474906113
    m_Localized: KUIDAS TOOTEID PAKITAKSE
    m_Metadata:
      m_Items: []
  - m_Id: 137269605474906114
    m_Localized: "P\xD5HILIIKUMISED"
    m_Metadata:
      m_Items: []
  - m_Id: 137269605483294720
    m_Localized: "<b>K\xF5ndimine / Jooksmine</b> \u2013 v\xF5imaldab sul laos ringi
      liikuda.\n\n<b>V\xF5tmine / Panemine</b> \u2013 v\xF5ta ese p\xF5randalt, laualt
      v\xF5i riiulilt, v\xF5i pane see sinna, kus sa seisad.\n\n<b>Viskamine</b>
      \u2013 viska see, mida k\xE4es hoiad, kaugele. Kiire, aga riskantne: kui see
      p\xF5rkab vastu midagi k\xF5va, l\xE4heb see katki ning sa kaotad raha ja mainet.
      Kui viskad selle meeskonnakaaslasele, kes selle p\xFC\xFCab, karistust pole
      \u2014 see s\xE4\xE4stab isegi aega.\n\n<b>Suhtlemine</b> \u2013 klientidega
      r\xE4\xE4kimine, telefoni t\xF5stmine, esemete v\xF5tmine riiulilt/laualt \u2014
      k\xF5ik k\xE4ib selle nupuga.\n\n<b>Kaart / Laoseisu kontroll</b> \u2013 avab
      lao \xFClevaate, et n\xE4eksid, mis kus on. See ei n\xE4ita meeskonnakaaslaste
      asukohti \u2014 seda tuleb raadio teel k\xFCsida."
    m_Metadata:
      m_Items: []
  - m_Id: 137269605483294721
    m_Localized: 'KUIDAS

      TOOTEID

      PAKITAKSE'
    m_Metadata:
      m_Items: []
  - m_Id: 137269605483294722
    m_Localized: "Kui r\xE4\xE4gid kliendiga, palub ta toote ja j\xE4tab selle oma
      lauale. Sellega t\xF6\xF6 ei l\xF5pe \u2014 toode pole veel pakitud.\n\nPakkimise
      sammud:\n\nV\xF5ta kliendi j\xE4etud pakendamata toode.\n\nMine l\xE4hima pakkimislaua
      juurde.\n\nV\xF5ta riiulilt tootega samav\xE4\xE4rses v\xE4rvis t\xFChi kast.\n\n\xDChenda
      toode ja kast laual \u2014 k\xF5igepealt teibiga, siis sildiga, ja pakk on
      valmis.\n\nN\xFC\xFCd on sul pakitud kast. J\xE4rgmisena tuleb tarne (vaata
      lehek\xFClge 6)."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859394301952
    m_Localized: Kliendid
    m_Metadata:
      m_Items: []
  - m_Id: 137293859406884864
    m_Localized: "Cargorit saab m\xE4ngida ka \xFCksi, aga t\xF5eline nali algab
      meeskonnas. M\xF5ned praktilised n\xF5uanded:\n\n- <b>Jagage t\xF6\xF6d:</b>
      las \xFCks j\xE4\xE4b pakkimislaua juurde, \xFCks jookseb veokite juurde, \xFCks
      tegeleb klientidega.\n- <b>R\xE4\xE4kige omavahel: </b>kui te pole samas ruumis,
      ei pruugi te \xFCksteist n\xE4ha \u2014 vaadake kaarti ja jagage valjusti,
      mis kus on.\n- <b>Visake ja p\xFC\xFCdke:</b> selle asemel, et kahe jaama vahet
      joosta, visake kast otse meeskonnakaaslasele.\n- <b>Leppige t\xE4iendustes
      kokku:</b> p\xFCsivad valikud m\xF5jutavad k\xF5iki, \xE4ra otsusta \xFCksi.\n\nEdu
      \u2014 tere tulemast Cargorisse!"
    m_Metadata:
      m_Items: []
  - m_Id: 137293859411079168
    m_Localized: Tere tulemast Cargorisse!
    m_Metadata:
      m_Items: []
  - m_Id: 137293859411079169
    m_Localized: Telefoniliin
    m_Metadata:
      m_Items: []
  - m_Id: 137293859411079170
    m_Localized: "Lao telefon heliseb aeg-ajalt. Mine see vastu v\xF5tma, et saada
      v\xE4ike raha- ja mainepreemia. Kui sa seda ei tee, ei kaota sa ka midagi \u2014
      telefon vaikib l\xF5puks iseenesest.\n\nKas see heliseb, s\xF5ltub t\xE4ielikult
      juhusest, aga m\xF5nel p\xE4eval (n\xE4iteks eris\xFCndmuste p\xE4evadel) t\xF5en\xE4osus
      suureneb. M\xF6\xF6daminnes pilku heitmine ei tee paha."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859415273472
    m_Localized: "<b> Vihje:  </b>Kui p\xE4ev hakkab l\xF5ppema, l\xF5peta see, mida
      teed, ja mine varakult puhkeruumi \u2014 \xE4ra lase oma meeskonnal oodata."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859415273473
    m_Localized: Erisoovid
    m_Metadata:
      m_Items: []
  - m_Id: 137293859415273474
    m_Localized: "<b> Vihje:  </b>\xC4ra vali ilma meeskonnaga r\xE4\xE4kimata \u2014
      \xFChe inimese valitud t\xE4iendus muudab k\xF5igi m\xE4ngu."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859415273475
    m_Localized: "Iga p\xE4ev n\xE4ed teatetahvlil m\xF5nda \xFClesannet \u2014 n\xE4iteks
      kasti riiulisse panek, toote pakkimine, veoki t\xE4itmine v\xF5i telefonile
      vastamine. Sa saad p\xE4evas vastu v\xF5tta ainult \xFChe.\n\n- Kui l\xF5petad
      vastuv\xF5etud \xFClesande enne p\xE4eva l\xF5ppu, makstakse su preemia automaatselt
      p\xE4eva l\xF5pus v\xE4lja.\n\n- Kui v\xF5tad selle vastu ja j\xE4tad pooleli,
      saad p\xE4eva l\xF5pus karistuse.\n\nKui sa \xFChtegi vastu ei v\xF5ta, ei
      juhtu midagi \u2014 aga j\xE4\xE4d ka v\xF5imalusest ilma. Vali \xFClesanne,
      mis on realistlik selle suhtes, millega parasjagu tegeled."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859415273476
    m_Localized: "Meeskonnat\xF6\xF6 N\xF5uanded"
    m_Metadata:
      m_Items: []
  - m_Id: 137293859415273477
    m_Localized: "\xDC\xFCr ja Sinu Raha"
    m_Metadata:
      m_Items: []
  - m_Id: 137293859419467776
    m_Localized: "Cargori pidamine pole tasuta. Teatud p\xE4evadel saabub \xFC\xFCrimakse
      \u2014 sellist p\xE4eva kutsume \"\xFC\xFCrip\xE4evaks\".\n\n- Kui sul on \xFC\xFCri
      jaoks piisavalt raha, see makstakse ja sa j\xE4tkad.\n\n- Kui sa ei suuda t\xE4htajaks
      maksta, saad \xFChekordse teise v\xF5imaluse: enamik su sularahast v\xF5etakse
      \xE4ra, aga \xE4ri ei sulgu.\n\n<b>Raha </b>tuleb \xF5igetest tarnetest, telefonik\xF5nedest
      ja l\xF5petatud \xFClesannetest. Valed tarned, mahakukkunud kastid ja pooleliolevad
      \xFClesanded v\xF5tavad sinult raha."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859419467777
    m_Localized: "<b> \xC4ra unusta:  </b>sa pole siin \xFCksi. Cargor on meeskonnat\xF6\xF6
      \u2014 jaga koormust, anna endast m\xE4rku."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859419467778
    m_Localized: "Tarni \xF5ige v\xE4rv \u2192 teenid raha, sinu maine t\xF5useb.\n\nTarni
      vale v\xE4rv \u2192 kaotad raha. Kontrolli v\xE4rve kaks korda.\n\nIgal veokil
      on piiratud ooteaeg ja mahutavus. Kui see saab t\xE4is v\xF5i aeg saab otsa,
      veok lahkub ja saabub uus.\n\nLao kasvades (t\xE4ienduste kaudu) v\xF5ib avaneda
      rohkem angaare \u2014 siis saad korraga toita mitut veokit."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859427856384
    m_Localized: "<b> Vihje:  </b>\xC4ra satu paanikasse segav\xE4rvi veokit v\xF5i
      topelttellimust n\xE4hes \u2014 m\xF5tle sellest lihtsalt kui kahest eraldi
      tarnest ja tegele nendega \xFCksteise j\xE4rel."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859427856385
    m_Localized: "T\xE4iendused"
    m_Metadata:
      m_Items: []
  - m_Id: 137293859427856386
    m_Localized: "Kui p\xE4ev l\xF5ppeb, peavad k\xF5ik minema puhkeruumi. Isegi
      kui ainult \xFCks inimene j\xE4\xE4b v\xE4ljapoole, p\xE4ev ei sulgu \u2014
      oodatakse, kuni kogu meeskond on koos.\n\nKui k\xF5ik on ruumis, ilmub p\xE4eva
      kokkuv\xF5te ja algab uus p\xE4ev. Kui j\xF5uad kuueteistk\xFCmnenda p\xE4eva
      l\xF5ppu ilma pankrotti minemata, oled pidustused \xE4ra teeninud."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859432050688
    m_Localized: "Puhkeruum ja P\xE4eva L\xF5pp"
    m_Metadata:
      m_Items: []
  - m_Id: 137293859432050689
    m_Localized: "Kliendid tulevad uksest sisse, seisavad j\xE4rjekorda ja paluvad
      sinult midagi. Nende kohal olev riba n\xE4itab, kui kannatlikud nad on \u2014
      kui see saab otsa, lahkub klient vihaselt ja sina kaotad raha ja mainet.\n\n-
      Liiklus muutub p\xE4eva jooksul: l\xF5una- ja \xF5htuaeg on k\xF5ige tihedamad,
      p\xE4rastl\xF5unal saad veidi hingata.\n\n- Kui r\xE4\xE4gid kliendiga (suhtlusnupp),
      j\xE4tab ta soovitud toote oma lauale \u2014 p\xE4rast seda j\xE4rgnevad pakkimine
      ja tarne (lehek\xFCljed 4-6).\n\n- Iga \xF5igel ajal teenindatud klient toob
      sulle nii raha kui mainet. Mida k\xF5rgem su maine, seda rohkem teenid tarne
      kohta."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859436244992
    m_Localized: "<b> Vihje:  </b>\xC4ra l\xFCkka rasket \xFClesannet viimasele p\xE4evale.
      P\xE4eva l\xF5pp saabub alati kiiremini, kui arvad."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859436244993
    m_Localized: "Tagastused, Topelttellimused, Segav\xE4rvi Veokid"
    m_Metadata:
      m_Items: []
  - m_Id: 137293859436244994
    m_Localized: "<b> Vihje:  </b>Kui telefon heliseb ja see j\xE4\xE4b sulle teele,
      astu l\xE4bi ka t\xE4isk\xE4tega \u2014 l\xFChike paus, v\xE4ike v\xF5it."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859444633600
    m_Localized: TERE TULEMAST!
    m_Metadata:
      m_Items: []
  - m_Id: 137293859444633601
    m_Localized: "\xDClesannete Tahvel"
    m_Metadata:
      m_Items: []
  - m_Id: 137293859444633602
    m_Localized: "P\xE4evade edenedes muutub t\xF6\xF6 veidi keerulisemaks. Sul tuleb
      ette kolm uut olukorda:\n\n<b>Tagastused: </b>m\xF5ned kliendid ei taha toodet
      \u2014 vastupidi, nad paluvad sul tuua neile kast tagasi. Nende kohal ilmuv
      v\xE4rviline kera n\xE4itab, millist v\xE4rvi kasti nad tahavad. V\xF5ta riiulilt
      \xF5ige v\xE4rv ja vii see kliendile.\n\n<b>Topelttellimus: </b>m\xF5ned kliendid
      tahavad korraga kahte erinevat v\xE4rvi. T\xF6\xF6 pole valmis enne, kui m\xF5lemad
      on valmis.\n\n<b>Segav\xE4rvi veok: </b>m\xF5ned veokid ei taha \xFCht v\xE4rvi,
      vaid kahte erinevat kastiv\xE4rvi. Kere segav\xE4rv (n\xE4iteks punane + kollane
      = oran\u017E) annab vihje \u2014 see n\xE4itab, millised kaks v\xE4rvi tuleb
      peale laadida."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859444633603
    m_Localized: "Angaaris ootavad veokid n\xE4itavad oma kere v\xE4rviga, mida nad
      tahavad: punane veok tahab punast kasti, kollane kollast, sinine sinist."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859448827904
    m_Localized: "Tere tulemast! N\xFC\xFCd oled Cargori pere osa. See koht on ladu,
      pood ja pisut kaost \u2014 k\xF5ik \xFChes.\n\nKliendid \xFCtlevad sulle, mida
      nad tahavad, sina pakid selle ja laadid \xF5igesse veokisse. K\xF5lab lihtsalt,
      eks? Kui oled kuueteistk\xFCmne p\xE4eva p\xE4rast ikka jalul, oled t\xF5esti
      head t\xF6\xF6d teinud.\n\nSee vihik sinu k\xE4es on koht, kuhu p\xF6\xF6rdud,
      kui unustad \xFCksikasjad. Iga lehek\xFClg k\xE4sitleb erinevat teemat. Kiiret
      pole \u2014 esimestel p\xE4evadel tee aeglaselt, tundma \xF5pi s\xFCsteemi.
      Kiirus tuleb ajaga."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859453022208
    m_Localized: "<b> Vihje:  </b>Kontrolli oma sularaha enne \xFC\xFCrip\xE4evi.
      \xC4ra j\xE4ta seda viimasele hetkele."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859453022209
    m_Localized: "<b> T\xE4helepanu:  </b>Kuni j\xE4rjekord on t\xE4is, uusi kliente
      ei tule, aga juba ootajad kaotavad edasi kannatust. \xC4ra alusta midagi uut,
      enne kui oled j\xE4rjekorra t\xFChjendanud."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859453022210
    m_Localized: "<b> Vihje:  </b>Kui n\xE4ed veoki v\xE4rvi juba kaugelt, eelista
      seda, mis \xFChtib sinu kaasas oleva kastiga \u2014 \xE4ra k\xE4i asjata."
    m_Metadata:
      m_Items: []
  - m_Id: 137293859461410816
    m_Localized: VEOKID JA TARNE
    m_Metadata:
      m_Items: []
  - m_Id: 137293859465605120
    m_Localized: "Teatud p\xE4evadel pakutakse sulle m\xF5nda t\xE4iendusvalikut
      \u2014 k\xF5iki ei saa v\xF5tta, valid nende vahel. Saad omandada p\xFCsivaid
      parendusi, nagu lisariiul, lisaangaar, kiirem liikumine v\xF5i pikem klientide
      kannatlikkus.\n\nM\xF5tle valik hoolikalt l\xE4bi: m\xF5ned t\xE4iendused v\xE4listavad
      \xFCksteist, teised avanevad alles teatud p\xE4evast. Valikud, mis kiirendavad
      esimestel p\xE4evadel p\xF5hit\xF5desid, tasuvad end hiljem palju \xE4ra."
    m_Metadata:
      m_Items: []
  - m_Id: 143536416780595200
    m_Localized: "Tere tulemast Cargorisse! V\xF5tad klientidelt tellimusi vastu
      ja toimetad need veokitesse. Vajuta j\xE4tkamiseks [SPACE]."
    m_Metadata:
      m_Items: []
  - m_Id: 143536416847704064
    m_Localized: "Mine kliendi juurde ja vajuta [{0}], seej\xE4rel vajuta laua juures
      uuesti [{0}], et toode k\xE4tte saada."
    m_Metadata:
      m_Items: []
  - m_Id: 143536416847704065
    m_Localized: Vii toode pakkimislauale ja vajuta [{0}], et see maha panna.
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092672
    m_Localized: "Vajuta riiuli juures [{0}], et v\xF5tta \xF5ige kast."
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092673
    m_Localized: "Vii kast pakkimislauale ja vajuta [{0}] \u2014 toode pannakse kasti, kuid see j\xE4\xE4b avatuks, kuni sa selle teibiga kinni ei teipa."
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263129
    m_Localized: "Vajuta teibijaama juures [{0}], et v\xF5tta rull teipi."
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263130
    m_Localized: "Teibiga k\xE4es vajuta pakkimislaua juures [{0}], et avatud kast kinni teibata."
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092674
    m_Localized: "Vajuta laua juures uuesti [{0}], et v\xF5tta teibitud kast."
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092675
    m_Localized: Vajuta [{0}], et panna kast riiulile.
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092676
    m_Localized: Veok saabub, oota veidi...
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092677
    m_Localized: "Vajuta riiuli juures uuesti [{0}], et v\xF5tta pakk."
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092678
    m_Localized: Vii pakk veoki taha ja viska see sisse.
    m_Metadata:
      m_Items: []
  - m_Id: 143536416856092679
    m_Localized: "Vahelej\xE4tmiseks vajuta [SPACE]"
    m_Metadata:
      m_Items: []
  - m_Id: 143536416860286976
    m_Localized: "\xD5petus l\xF5petatud!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263131
    m_Localized: "Steami \xFChendus puudub!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263132
    m_Localized: "Ooteruumi loomine eba\xF5nnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263133
    m_Localized: "Ooteruumiga liitumine eba\xF5nnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263134
    m_Localized: "\xDChenduse viga!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263135
    m_Localized: "V\xF5rgu viga!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263136
    m_Localized: "M\xE4ngu loomine eba\xF5nnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263137
    m_Localized: "M\xE4ngu looja viga!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263138
    m_Localized: "\xDChendus eba\xF5nnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263139
    m_Localized: "Vigane ooteruum!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263140
    m_Localized: "Ooteruumi viga!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263141
    m_Localized: "Tekkis ootamatu viga!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263142
    m_Localized: "Palun sisesta ooteruumi kood!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263143
    m_Localized: "Vigane ooteruumi kood!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263144
    m_Localized: "Kehtivat ooteruumi pole!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263145
    m_Localized: "Ooteruumi kontrollimine eba\xF5nnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263146
    m_Localized: "Esmalt pead looma ooteruumi!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263147
    m_Localized: "Steami kutsemen\xFC\xFCd ei \xF5nnestunud avada!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263148
    m_Localized: "Ainult m\xE4ngu looja saab m\xE4ngu alustada!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263149
    m_Localized: "V\xF5rk pole valmis!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263150
    m_Localized: "Stseeni laadimine eba\xF5nnestus!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263151
    m_Localized: "Ooteruumi pole olemas!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263152
    m_Localized: "Sul pole luba selle ooteruumiga liituda!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263153
    m_Localized: "Ooteruum on t\xE4is!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263154
    m_Localized: "Sul on sellesse ooteruumi sissep\xE4\xE4s keelatud!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263155
    m_Localized: "Sinu konto on piiratud!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263156
    m_Localized: "Klann on keelatud!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263157
    m_Localized: "Sul on kogukonnakeeld!"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263158
    m_Localized: "Liitumine eba\xF5nnestus: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263159
    m_Localized: "M\xE4ng on juba alanud."
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263160
    m_Localized: "P\xE4ev {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 144849164114263161
    m_Localized: "T\xE4na \xFC\xFCr!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
