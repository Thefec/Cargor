    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "S\xF3 o anfitri\xE3o pode expulsar jogadores!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: Jogador expulso!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
