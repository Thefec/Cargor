  - m_Id: 30570000000000002
    m_Localized: 'Razem: {0} graczy'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Status pokoju socjalnego
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "W \u015Brodku: {0} / {1} graczy"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: Wszyscy gotowi!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: Oczekiwanie na {0} graczy...
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: Nie znaleziono graczy
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: Gracz
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: Samouczek
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Tylko host mo\u017Ce wyrzuca\u0107 graczy!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: Gracz wyrzucony!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Nie uda\u0142o si\u0119 wyrzuci\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: Puste miejsce
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "Dzie\u0144 {0}  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Dzie\u0144 zako\u0144czony. Id\u017A do pokoju socjalnego."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Dzie\u0144 czynszu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Poziom: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Koszt: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Maks
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Kup
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Kolejka
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Zwi\u0119ksza maksymalny rozmiar kolejki klient\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Wytrzyma\u0142o\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Zwi\u0119ksza tempo regeneracji wytrzyma\u0142o\u015Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Pieni\u0105dze"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Zwi\u0119ksza nagrod\u0119 za ka\u017Cd\u0105 dostarczon\u0105
      paczk\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Ci\u0119\u017Car\xF3wka"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Odblokowuje dodatkowe hangary dla ci\u0119\u017Car\xF3wek."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: Poziom zadania
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Odblokowuje zadania wy\u017Cszego poziomu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "PRACOWITY DZIE\u0143"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Cz\u0119stotliwo\u015B\u0107 pojawiania si\u0119 klient\xF3w wzrasta
      o 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: ZDENERWOWANI KLIENCI
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Cierpliwo\u015B\u0107 klient\xF3w spada o 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: WOLNA LOGISTYKA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Ci\u0119\u017Car\xF3wki opuszczaj\u0105 plac o 50% wolniej."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "CI\u0118\u017BKIE PUD\u0141A"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Og\xF3lna pr\u0119dko\u015B\u0107 poruszania si\u0119 spada o 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBLEM ZE ZM\u0118CZENIEM"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Wytrzyma\u0142o\u015B\u0107 regeneruje si\u0119 o 40% wolniej,
      a pr\u0119dko\u015B\u0107 sprintu spada o 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: NIESPODZIEWANA KONTROLA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Wszystkie b\u0142\u0119dne operacje karane s\u0105 podw\xF3jnie."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "DZIE\u0143 MARKETINGU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% wi\u0119cej klient\xF3w, ale 30% mniej zarobk\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "OBS\u0141UGA KLIENTA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Telefon w recepcji dzwoni o 50% cz\u0119\u015Bciej."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS ZA DOSTAW\u0118"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Zarabiaj o 20% wi\u0119cej za ka\u017Cd\u0105 dostaw\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "SPOKOJNY DZIE\u0143"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Cierpliwo\u015B\u0107 klient\xF3w wzrasta o 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EKSPRESOWY \u0141ADUNEK"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Ci\u0119\u017Car\xF3wki opuszczaj\u0105 plac o 30% szybciej."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "DZIE\u0143 Z\u0141OTEGO PUD\u0141A"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Ka\u017Cda poprawnie dostarczona paczka daje dodatkowe 30%. Przynosi
      te\u017C o 20% wi\u0119cej klient\xF3w, o 20% szybsze wyjazdy ci\u0119\u017Car\xF3wek
      i o 20% szybszy ruch, ale wytrzyma\u0142o\u015B\u0107 regeneruje si\u0119 o
      20% wolniej."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "DZIE\u0143 OKAZJI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Koszty ulepsze\u0144 spadaj\u0105 o 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "DZIE\u0143 LIMITU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Wszystkie ci\u0119\u017Car\xF3wki \u017C\u0105daj\u0105 tylko jednego
      koloru paczki."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "US\u0141UGA VIP"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% szansy, \u017Ce paczka jest idealna i daje o 10% wi\u0119cej."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "DESZCZOWY DZIE\u0143"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Przychodzi o 20% mniej klient\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "DZIE\u0143 FESTIWALU"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Na pocz\u0105tku dnia przyznawany jest losowy bonus."
    m_Metadata:
      m_Items: []
