    m_Localized: "Resistenza"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Aumenta la velocità di rigenerazione della resistenza."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Denaro"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Aumenta la ricompensa per ogni scatola consegnata."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Camion"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Sblocca hangar per camion aggiuntivi."
    m_Metadata:
      m_Items: []
