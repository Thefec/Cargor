      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "GIORNATA INTENSA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Il tasso di comparsa dei clienti aumenta del 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "CLIENTI ARRABBIATI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "La pazienza dei clienti diminuisce del 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "LOGISTICA LENTA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "I camion lasciano la scena il 50% più lentamente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "SCATOLE PESANTI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "La velocità di movimento complessiva diminuisce del 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "PROBLEMA DI STANCHEZZA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "La resistenza si rigenera il 40% più lentamente e la velocità di scatto diminuisce del 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "CONTROLLO A SORPRESA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Tutte le operazioni errate penalizzano il doppio."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "GIORNATA MARKETING"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% di clienti in più, ma 30% di guadagni in meno."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "ASSISTENZA CLIENTI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Il telefono della reception squilla il 50% più spesso."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "BONUS CONSEGNA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Guadagna il 20% in più per ogni consegna."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "GIORNATA RILASSATA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "La pazienza dei clienti aumenta del 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "CARICO ESPRESSO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "I camion lasciano la scena il 30% più velocemente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "GIORNATA DELLA SCATOLA D'ORO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Ogni scatola consegnata correttamente frutta un extra del 30%. Porta anche il 20% di clienti in più, uscite dei camion il 20% più veloci e movimento il 20% più veloce, ma la resistenza si rigenera il 20% più lentamente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "GIORNATA DELL'OPPORTUNITÀ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "I costi di miglioramento diminuiscono del 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "GIORNATA QUOTA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Tutti i camion richiedono un solo colore di scatola."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "SERVIZIO VIP"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% di probabilità che le scatole siano perfette e fruttino il 10% in più."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "GIORNATA PIOVOSA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Arrivano il 20% di clienti in meno."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "GIORNATA DEL FESTIVAL"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Si ottiene un bonus casuale all'inizio della giornata."
