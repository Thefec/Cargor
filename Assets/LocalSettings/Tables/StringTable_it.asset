    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: 'Totale: {0} giocatori'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Stato della sala relax
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: 'Dentro: {0} / {1} giocatori'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: Tutti pronti!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: In attesa di {0} giocatori...
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: Nessun giocatore trovato
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: Giocatore
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Solo l'host pu\xF2 espellere i giocatori!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: Giocatore espulso!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: Espulsione fallita!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: Posto vuoto
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: Giorno {0}  {1}:{2} ({3}s)
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: Giornata finita. Vai alla sala relax.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: Giorno dell'affitto
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Livello: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Costo: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Max
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Compra
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Coda
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: Aumenta la dimensione massima della coda clienti.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: Resistenza
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Aumenta la velocit\xE0 di rigenerazione della resistenza."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Denaro
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: Aumenta la ricompensa per ogni scatola consegnata.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Camion
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: Sblocca hangar per camion aggiuntivi.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: Livello missione
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: Sblocca missioni di livello superiore.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: GIORNATA INTENSA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: Il tasso di comparsa dei clienti aumenta del 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: CLIENTI ARRABBIATI
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: La pazienza dei clienti diminuisce del 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: LOGISTICA LENTA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "I camion lasciano la scena il 50% pi\xF9 lentamente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: SCATOLE PESANTI
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "La velocit\xE0 di movimento complessiva diminuisce del 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: PROBLEMA DI STANCHEZZA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "La resistenza si rigenera il 40% pi\xF9 lentamente e la velocit\xE0
      di scatto diminuisce del 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: CONTROLLO A SORPRESA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: Tutte le operazioni errate penalizzano il doppio.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: GIORNATA MARKETING
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% di clienti in pi\xF9, ma 30% di guadagni in meno."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: ASSISTENZA CLIENTI
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Il telefono della reception squilla il 50% pi\xF9 spesso."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: BONUS CONSEGNA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Guadagna il 20% in pi\xF9 per ogni consegna."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: GIORNATA RILASSATA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: La pazienza dei clienti aumenta del 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: CARICO ESPRESSO
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "I camion lasciano la scena il 30% pi\xF9 velocemente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: GIORNATA DELLA SCATOLA D'ORO
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Ogni scatola consegnata correttamente frutta un extra del 30%.
      Porta anche il 20% di clienti in pi\xF9, uscite dei camion il 20% pi\xF9 veloci
      e movimento il 20% pi\xF9 veloce, ma la resistenza si rigenera il 20% pi\xF9
      lentamente."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "GIORNATA DELL'OPPORTUNIT\xC0"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: I costi di miglioramento diminuiscono del 20%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: GIORNATA QUOTA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: Tutti i camion richiedono un solo colore di scatola.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: SERVIZIO VIP
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% di probabilit\xE0 che le scatole siano perfette e fruttino
      il 10% in pi\xF9."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: GIORNATA PIOVOSA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: Arrivano il 20% di clienti in meno.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: GIORNATA DEL FESTIVAL
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: Si ottiene un bonus casuale all'inizio della giornata.
    m_Metadata:
      m_Items: []
