      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: "Jugar en l\xEDnea"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: Jugadores en la sala
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: 'Total: {0} jugadores'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Estado de la sala de descanso
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: 'Dentro: {0} / {1} jugadores'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "\xA1Todos est\xE1n listos!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: Esperando a {0} jugadores...
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: No se encontraron jugadores
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: Jugador
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "\xA1Solo el anfitri\xF3n puede expulsar jugadores!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "\xA1Jugador expulsado!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "\xA1Error al expulsar!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Espacio vac\xEDo"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "D\xEDa {0}  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "D\xEDa terminado. Ve a la sala de descanso."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "D\xEDa de alquiler"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Nivel: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Costo: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: "M\xE1x"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Comprar
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Cola
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Aumenta el tama\xF1o m\xE1ximo de la cola de clientes."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: Resistencia
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Aumenta la velocidad de regeneraci\xF3n de resistencia."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Dinero
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: Aumenta la recompensa por caja entregada.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Cami\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: Desbloquea hangares de camiones adicionales.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Nivel de misi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: Desbloquea misiones de nivel superior.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "D\xCDA OCUPADO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "La tasa de aparici\xF3n de clientes aumenta un 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: CLIENTES ENFADADOS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: La paciencia de los clientes disminuye un 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "LOG\xCDSTICA LENTA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Los camiones abandonan la escena un 50% m\xE1s lento."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: CAJAS PESADAS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: La velocidad de movimiento general se reduce un 20%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: PROBLEMA DE FATIGA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "La resistencia se regenera un 40% m\xE1s lento y la velocidad de
      sprint baja un 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "AUDITOR\xCDA SORPRESA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Todas las operaciones err\xF3neas penalizan el doble."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "D\xCDA DE MARKETING"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20% m\xE1s de clientes, pero 30% menos de ganancias."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "ATENCI\xD3N AL CLIENTE"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "El tel\xE9fono de recepci\xF3n suena un 50% m\xE1s a menudo."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: BONO DE ENTREGA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Gana un 20% m\xE1s de dinero por entrega."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "D\xCDA RELAJADO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: La paciencia de los clientes aumenta un 30%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "CARGA EXPR\xC9S"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Los camiones abandonan la escena un 30% m\xE1s r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "D\xCDA DE LA CAJA DORADA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Cada caja entregada correctamente gana un 30% extra. Tambi\xE9n
      trae un 20% m\xE1s de clientes, salidas de cami\xF3n un 20% m\xE1s r\xE1pidas
      y movimiento un 20% m\xE1s r\xE1pido, pero la resistencia se regenera un 20%
      m\xE1s lento."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "D\xCDA DE LA OPORTUNIDAD"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: El costo de mejoras disminuye un 20%.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "D\xCDA DE CUOTA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: Todos los camiones piden solo un color de caja.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: SERVICIO VIP
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% de probabilidad de que las cajas sean perfectas y ganen un
      10% m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "D\xCDA LLUVIOSO"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: Llegan un 20% menos de clientes.
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "D\xCDA DE FESTIVAL"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Se gana un bono aleatorio al inicio del d\xEDa."
    m_Metadata:
      m_Items: []
