  - m_Id: 30568446771507200
    m_Localized: "Izv\u0113l\u0113ties karti\n(Dr\u012Bzum\u0101)"
    m_Metadata:
      m_Items: []
  - m_Id: 30568844051787776
    m_Localized: Galvenais birojs
    m_Metadata:
      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: "Sp\u0113l\u0113t tie\u0161saist\u0113"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Sp\u0113l\u0113t\u0101ji vestibil\u0101"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Kop\u0101: {0} sp\u0113l\u0113t\u0101ji"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Atp\u016Btas telpas statuss"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Iek\u0161\u0101: {0} / {1} sp\u0113l\u0113t\u0101ji"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: Visi ir gatavi!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Gaida {0} sp\u0113l\u0113t\u0101jus..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Sp\u0113l\u0113t\u0101ji nav atrasti"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Sp\u0113l\u0113t\u0101js"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Apm\u0101c\u012Bba"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Tikai sp\u0113les saimnieks var izraid\u012Bt sp\u0113l\u0113t\u0101jus!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Sp\u0113l\u0113t\u0101js izraid\u012Bts!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Izraid\u012B\u0161ana neizdev\u0101s!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Tuk\u0161a vieta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: '{0}. diena  {1}:{2} ({3}s)'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Diena beigusies. Dodies uz atp\u016Btas telpu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: Nomas maksas diena
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "L\u012Bmenis: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Izmaksas: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Maks
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: Pirkt
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Rinda
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Palielina maksim\u0101lo klientu rindas garumu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Iztur\u012Bba"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Palielina iztur\u012Bbas atjauno\u0161an\u0101s \u0101trumu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Nauda
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Palielina atl\u012Bdz\u012Bbu par katru pieg\u0101d\u0101to kasti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Kravas auto
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Atblo\u0137\u0113 papildu kravas auto ang\u0101rus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Uzdevuma l\u012Bmenis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Atblo\u0137\u0113 augst\u0101ka l\u012Bme\u0146a uzdevumus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "AIZ\u0145EMTA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Klientu iera\u0161an\u0101s \u0101trums palielin\u0101s par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "DUSM\u012AGI KLIENTI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Klientu paciet\u012Bba samazin\u0101s par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "L\u0112NA LO\u0122ISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kravas auto pamet vietu par 50% l\u0113n\u0101k."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: SMAGAS KASTES
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Kop\u0113jais kust\u012Bbas \u0101trums samazin\u0101s par 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "NOGURUMA PROBL\u0112MA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Iztur\u012Bba atjaunojas par 40% l\u0113n\u0101k, un sprinta \u0101trums
      samazin\u0101s par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "P\u0100RSTEIGUMA REV\u012AZIJA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Visas k\u013C\u016Bdain\u0101s darb\u012Bbas tiek sod\u012Btas
      dubult\u0101."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "M\u0100RKETINGA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "Par 20% vair\u0101k klientu, bet par 30% maz\u0101k pe\u013C\u0146as."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: KLIENTU ATBALSTS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Re\u0123istrat\u016Bras t\u0101lrunis zvana par 50% bie\u017E\u0101k."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "PIEG\u0100DES BONUSS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Nopelni par 20% vair\u0101k naudas par katru pieg\u0101di."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "MIER\u012AGA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Klientu paciet\u012Bba palielin\u0101s par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: EKSPRESKRAVA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kravas auto pamet vietu par 30% \u0101tr\u0101k."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: ZELTA KASTES DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Katra pareizi pieg\u0101d\u0101t\u0101 kaste dod papildu 30%. T\u0101
      ar\u012B atnes par 20% vair\u0101k klientu, par 20% \u0101tr\u0101ku kravas
      auto izbrauk\u0161anu un par 20% \u0101tr\u0101ku kust\u012Bbu, ta\u010Du iztur\u012Bba
      atjaunojas par 20% l\u0113n\u0101k."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "IESP\u0112JU DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Uzlabojumu izmaksas samazin\u0101s par 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: KVOTAS DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Visi kravas auto pieprasa tikai vienu kastes kr\u0101su."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: VIP SERVISS
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% iesp\u0113ja, ka kaste ir perfekta un dod par 10% vair\u0101k."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: LIETAINA DIENA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Ierodas par 20% maz\u0101k klientu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "FESTIV\u0100LA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Dienas s\u0101kum\u0101 tiek ieg\u016Bts nejau\u0161s bonuss."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "Sp\u0113l\u0113t\u0101ji"
