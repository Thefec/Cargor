  - m_Id: 30569701396885504
    m_Localized: "Spēlēt tiešsaistē"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "Spēlētāji vestibilā"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "Kopā: {0} spēlētāji"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Atpūtas telpas statuss"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Iekšā: {0} / {1} spēlētāji"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Visi ir gatavi!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "Gaida {0} spēlētājus..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Spēlētāji nav atrasti"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "Spēlētājs"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Apmācība"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Tikai spēles saimnieks var izraidīt spēlētājus!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "Spēlētājs izraidīts!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Izraidīšana neizdevās!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Tukša vieta"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "{0}. diena  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "Diena beigusies. Dodies uz atpūtas telpu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Nomas maksas diena"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: "Līmenis: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "Izmaksas: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: "Maks"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "Pirkt"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: "Rinda"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Palielina maksimālo klientu rindas garumu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "Izturība"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Palielina izturības atjaunošanās ātrumu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "Nauda"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Palielina atlīdzību par katru piegādāto kasti."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Kravas auto"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Atbloķē papildu kravas auto angārus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "Uzdevuma līmenis"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Atbloķē augstāka līmeņa uzdevumus."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "AIZŅEMTA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "Klientu ierašanās ātrums palielinās par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "DUSMĪGI KLIENTI"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "Klientu pacietība samazinās par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "LĒNA LOĢISTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kravas auto pamet vietu par 50% lēnāk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "SMAGAS KASTES"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Kopējais kustības ātrums samazinās par 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "NOGURUMA PROBLĒMA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Izturība atjaunojas par 40% lēnāk, un sprinta ātrums samazinās par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "PĀRSTEIGUMA REVĪZIJA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Visas kļūdainās darbības tiek sodītas dubultā."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "MĀRKETINGA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "Par 20% vairāk klientu, bet par 30% mazāk peļņas."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "KLIENTU ATBALSTS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "Reģistratūras tālrunis zvana par 50% biežāk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "PIEGĀDES BONUSS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Nopelni par 20% vairāk naudas par katru piegādi."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "MIERĪGA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "Klientu pacietība palielinās par 30%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EKSPRESKRAVA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kravas auto pamet vietu par 30% ātrāk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "ZELTA KASTES DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Katra pareizi piegādātā kaste dod papildu 30%. Tā arī atnes par 20% vairāk klientu, par 20% ātrāku kravas auto izbraukšanu un par 20% ātrāku kustību, taču izturība atjaunojas par 20% lēnāk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "IESPĒJU DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Uzlabojumu izmaksas samazinās par 20%."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "KVOTAS DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Visi kravas auto pieprasa tikai vienu kastes krāsu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP SERVISS"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% iespēja, ka kaste ir perfekta un dod par 10% vairāk."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "LIETAINA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "Ierodas par 20% mazāk klientu."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "FESTIVĀLA DIENA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "Dienas sākumā tiek iegūts nejaušs bonuss."
    m_Metadata:
      m_Items: []
