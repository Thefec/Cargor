    m_Metadata:
      m_Items: []
  - m_Id: 4672484777832448
    m_Localized: "K\xF6vetkez\u0151 nap"
    m_Metadata:
      m_Items: []
  - m_Id: 4672617426890752
    m_Localized: "Folytat\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 30567298710810624
    m_Localized: "J\xE1t\xE9k l\xE9trehoz\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 30567344864931840
    m_Localized: "Csatlakoz\xE1s a j\xE1t\xE9khoz"
    m_Metadata:
      m_Items: []
  - m_Id: 30567847749398528
    m_Localized: "Kezd\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 30567978871730176
    m_Localized: Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 30568446771507200
    m_Localized: "V\xE1lassz p\xE1ly\xE1t\n(Hamarosan)"
    m_Metadata:
      m_Items: []
  - m_Id: 30568844051787776
    m_Localized: "A f\u0151iroda"
    m_Metadata:
      m_Items: []
  - m_Id: 30569701396885504
    m_Localized: "Online j\xE1t\xE9k"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: "J\xE1t\xE9kosok a v\xE1r\xF3teremben"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: "\xD6sszesen: {0} j\xE1t\xE9kos"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: "Pihen\u0151szoba \xE1llapota"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "Bent: {0} / {1} j\xE1t\xE9kos"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Mindenki k\xE9szen \xE1ll!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: "V\xE1rakoz\xE1s {0} j\xE1t\xE9kosra..."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: "Nem tal\xE1lhat\xF3 j\xE1t\xE9kos"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: "J\xE1t\xE9kos"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "Bevezet\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Csak a szoba gazd\xE1ja dobhat ki j\xE1t\xE9kosokat!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: "J\xE1t\xE9kos kir\xFAgva!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "A kir\xFAg\xE1s sikertelen!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "\xDCres hely"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: '{0}. nap  {1}:{2} ({3}s)'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "A nap v\xE9get \xE9rt. Menj a pihen\u0151szob\xE1ba."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "B\xE9rleti nap"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Szint: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: "\xC1r: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Max
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "V\xE1s\xE1rl\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Sor
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "N\xF6veli a v\xE1s\xE1rl\xF3i sor maxim\xE1lis m\xE9ret\xE9t."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: "\xC1ll\xF3k\xE9pess\xE9g"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "N\xF6veli az \xE1ll\xF3k\xE9pess\xE9g regener\xE1l\xF3d\xE1si sebess\xE9g\xE9t."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: "P\xE9nz"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "N\xF6veli a dobozonk\xE9nti sz\xE1ll\xEDt\xE1si jutalmat."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: "Teheraut\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Feloldja a tov\xE1bbi teheraut\xF3-hang\xE1rokat."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "K\xFCldet\xE9sszint"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Feloldja a magasabb szint\u0171 k\xFCldet\xE9seket."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: ELFOGLALT NAP
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "A v\xE1s\xE1rl\xF3k megjelen\xE9si ar\xE1nya 30%-kal n\u0151."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "D\xDCH\xD6S V\xC1S\xC1RL\xD3K"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "A v\xE1s\xE1rl\xF3k t\xFCrelme 30%-kal cs\xF6kken."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "LASS\xDA LOGISZTIKA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "A teheraut\xF3k 50%-kal lassabban hagyj\xE1k el a helysz\xEDnt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "NEH\xC9Z DOBOZOK"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Az \xE1ltal\xE1nos mozg\xE1si sebess\xE9g 20%-kal cs\xF6kken."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: "F\xC1RADTS\xC1GI PROBL\xC9MA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Az \xE1ll\xF3k\xE9pess\xE9g 40%-kal lassabban t\xF6lt\u0151dik,
      a sprintsebess\xE9g pedig 30%-kal cs\xF6kken."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "MEGLEPET\xC9S-ELLEN\u0150RZ\xC9S"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "Minden hib\xE1s m\u0171velet dupla b\xFCntet\xE9st kap."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: MARKETINGNAP
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "20%-kal t\xF6bb v\xE1s\xE1rl\xF3, de 30%-kal kevesebb bev\xE9tel."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "\xDCGYF\xC9LSZOLG\xC1LAT"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "A recepci\xF3s telefon 50%-kal gyakrabban cs\xF6r\xF6g."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: "SZ\xC1LL\xCDT\xC1SI B\xD3NUSZ"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "20%-kal t\xF6bb p\xE9nzt keresel sz\xE1ll\xEDt\xE1sonk\xE9nt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: NYUGODT NAP
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "A v\xE1s\xE1rl\xF3k t\xFCrelme 30%-kal n\u0151."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: "EXPRESSZ RAKOM\xC1NY"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "A teheraut\xF3k 30%-kal gyorsabban hagyj\xE1k el a helysz\xEDnt."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: ARANY DOBOZ NAPJA
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Minden helyesen kisz\xE1ll\xEDtott doboz plusz 30%-ot \xE9r. Emellett
      20%-kal t\xF6bb v\xE1s\xE1rl\xF3t, 20%-kal gyorsabb teheraut\xF3-indul\xE1st
      \xE9s 20%-kal gyorsabb mozg\xE1st hoz, de az \xE1ll\xF3k\xE9pess\xE9g 20%-kal
      lassabban t\xF6lt\u0151dik."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "A LEHET\u0150S\xC9GEK NAPJA"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "A fejleszt\xE9sek \xE1ra 20%-kal cs\xF6kken."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "KV\xD3TANAP"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "Minden teheraut\xF3 csak egyf\xE9le doboz sz\xEDnt k\xE9r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP SZOLG\xC1LTAT\xC1S"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "10% es\xE9ly, hogy a doboz t\xF6k\xE9letes \xE9s 10%-kal t\xF6bbet
      \xE9r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "ES\u0150S NAP"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "20%-kal kevesebb v\xE1s\xE1rl\xF3 \xE9rkezik."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "FESZTIV\xC1LNAP"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "A nap elej\xE9n v\xE9letlenszer\u0171 b\xF3nuszt kapsz."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: "J\xE1t\xE9kosok"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: "({0}/{1} a pihen\u0151szob\xE1ban)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: "V\xE1rhat\xF3 v\xE1s\xE1rl\xF3k"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: Piros
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000069
    m_Localized: "K\xE9k"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000070
    m_Localized: "S\xE1rga"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000071
    m_Localized: "Z\xF6ld"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000072
    m_Localized: "Nincs k\xFCldet\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000073
    m_Localized: Jutalom
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000074
    m_Localized: "B\xFCntet\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000075
    m_Localized: "Teljes\xEDtve"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000076
    m_Localized: Sikertelen
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000077
    m_Localized: "Teljes\xEDtsd a minij\xE1t\xE9kot {0} alkalommal"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000078
    m_Localized: Helyezz {0} dobozt a polcra
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000079
    m_Localized: Helyezz {0} {1} dobozt a polcra
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000080
    m_Localized: "Fejezz be {0} teheraut\xF3t"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000081
    m_Localized: "Szolg\xE1lj ki {0} v\xE1s\xE1rl\xF3t"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000082
    m_Localized: "Hagyj figyelmen k\xEDv\xFCl {0} v\xE1s\xE1rl\xF3t"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000083
    m_Localized: "Csomagolj be {0} j\xE1t\xE9kot"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000107
    m_Localized: "Ma m\xE1r elfogadt\xE1l egy k\xFCldet\xE9st"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000108
    m_Localized: "Elfogad\xE1s"
    m_Metadata:
      m_Items: []
