    m_Localized: "<color=#4B4E6D>2</color>      Cargor\u2019a Ho\u015F Geldin!\n<color=#4B4E6D>3</color>     
      Temel Hareketler\n<color=#4B4E6D>4</color>      \xDCr\xFCnler Nas\u0131l Paketlenir\n<color=#4B4E6D>5</color>     
      Rafa Yerle\u015Ftirme\n<color=#4B4E6D>6</color>      T\u0131rlar ve Teslimat\n<color=#4B4E6D>7</color>      
      M\xFC\u015Fteriler\n<line-height=18><color=#4B4E6D>8</color>      \xD6zel Talepler:
      \u0130adeler,\r\n\xC7ift Sipari\u015F, Kar\u0131\u015F\u0131k T\u0131rlar</line-height>\n<color=#4B4E6D>9</color>     
      Kira ve Paran\n<color=#4B4E6D>10</color>   Y\xFCkseltmeler\n<color=#4B4E6D>11</color>   
      G\xF6rev Panosu\n<color=#4B4E6D>12</color>    Telefon Hatt\u0131\n<color=#4B4E6D>13</color>   
      Dinlenme Odas\u0131 ve G\xFCn Sonu\n<color=#4B4E6D>14</color>    Ekip \xC7al\u0131\u015Fmas\u0131
      \u0130pu\xE7lar\u0131"
