  - m_Id: 30569701396885504
    m_Localized: "\xC7ok Oyunculu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000001
    m_Localized: Lobideki Oyuncular
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000002
    m_Localized: 'Toplam: {0} oyuncu'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000003
    m_Localized: Break Room Durumu
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000004
    m_Localized: "\u0130\xE7eride: {0} / {1} oyuncu"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000005
    m_Localized: "Herkes haz\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000006
    m_Localized: '{0} oyuncu bekleniyor...'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000007
    m_Localized: Oyuncu bulunamad\u0131
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000008
    m_Localized: Oyuncu
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000009
    m_Localized: "E\u011Fitim"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000010
    m_Localized: "Sadece host oyuncular\u0131 kickleyebilir!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000011
    m_Localized: Oyuncu kicklendi!
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000012
    m_Localized: "Kick i\u015Flemi ba\u015Far\u0131s\u0131z!"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000013
    m_Localized: "Bo\u015F Slot"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000014
    m_Localized: "G\xFCn {0}  {1}:{2} ({3}s)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000015
    m_Localized: "G\xFCn Bitti. Mola Odas\u0131na Gidin."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000016
    m_Localized: "Kira G\xFCn\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000017
    m_Localized: 'Seviye: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000018
    m_Localized: 'Maliyet: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000019
    m_Localized: Maks
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000020
    m_Localized: "Sat\u0131n Al"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000021
    m_Localized: Kuyruk
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000022
    m_Localized: "Maksimum m\xFC\u015Fteri kuyruk boyutunu art\u0131r\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000023
    m_Localized: Dayaniklilik
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000024
    m_Localized: "Dayan\u0131kl\u0131l\u0131k yenileme h\u0131z\u0131n\u0131 art\u0131r\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000025
    m_Localized: Para
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000026
    m_Localized: "Kutu teslimat\u0131 ba\u015F\u0131na \xF6d\xFCl\xFC art\u0131r\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000027
    m_Localized: Kamyon
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000028
    m_Localized: "Ek kamyon hangarlar\u0131 a\xE7ar."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000029
    m_Localized: "G\xF6rev Seviyesi"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000030
    m_Localized: "Daha y\xFCksek seviye g\xF6revleri a\xE7ar."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000031
    m_Localized: "YO\u011EUN G\xDCN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000032
    m_Localized: "M\xFC\u015Fteri do\u011Fma oran\u0131 %30 artar."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000033
    m_Localized: "SINIRLI M\xDC\u015ETER\u0130LER"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000034
    m_Localized: "M\xFC\u015Fteri sabr\u0131 %30 azal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000035
    m_Localized: "YAVA\u015E LOJ\u0130ST\u0130K"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000036
    m_Localized: "Kamyonlar sahneyi %50 daha yava\u015F terk eder."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000037
    m_Localized: "A\u011EIR KUTULAR"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000038
    m_Localized: "Genel hareket h\u0131z\u0131 %20 yava\u015Flar."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000039
    m_Localized: YORGUNLUK SORUNU
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000040
    m_Localized: "Dayan\u0131kl\u0131l\u0131k %40 daha yava\u015F yenilenir ve ko\u015Fu
      h\u0131z\u0131 %30 azal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000041
    m_Localized: "S\xDCRPR\u0130Z DENET\u0130M"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000042
    m_Localized: "T\xFCm hatalar iki kat ceza al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000043
    m_Localized: "PAZARLAMA G\xDCN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000044
    m_Localized: "%20 fazla m\xFC\u015Fteri, ama %30 az kazan\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000045
    m_Localized: "M\xDC\u015ETER\u0130 DESTE\u011E\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000046
    m_Localized: "D\u0131\u015Far\u0131 aramalarda zaman atlamas\u0131 yar\u0131ya
      iner."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000047
    m_Localized: TESLIMAT BONUSU
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000048
    m_Localized: "Teslimat ba\u015F\u0131na %20 daha fazla para kazan."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000049
    m_Localized: "RAHAT B\u0130R G\xDCN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000050
    m_Localized: "M\xFC\u015Fteri sabr\u0131 %30 artar."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000051
    m_Localized: EKSPRES KARGO
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000052
    m_Localized: "Kamyonlar sahneyi %30 daha h\u0131zl\u0131 terk eder."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000053
    m_Localized: "ALTIN KUTU G\xDCN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000054
    m_Localized: "Do\u011Fru teslim edilen her kutu %30 ekstra kazan\u0131r. Ayr\u0131ca
      %20 daha fazla m\xFC\u015Fteri gelir, kamyonlar %20 daha h\u0131zl\u0131 \xE7\u0131kar
      ve hareket h\u0131z\u0131 %20 artar, ancak dayan\u0131kl\u0131l\u0131k %20
      daha yava\u015F yenilenir."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000055
    m_Localized: "FIRSAT G\xDCN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000056
    m_Localized: "Y\xFCkseltme maliyetleri %20 azal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000057
    m_Localized: "KOTA G\xDCN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000058
    m_Localized: "T\xFCm kamyonlar tek renk kutu ister."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000059
    m_Localized: "VIP H\u0130ZMET"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000060
    m_Localized: "%10 ihtimalle kutular m\xFCkemmel ve %10 daha fazla kazan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000061
    m_Localized: "YA\u011EMURLU G\xDCN"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000062
    m_Localized: "%20 daha az m\xFC\u015Fteri gelir."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000063
    m_Localized: "FEST\u0130VAL G\xDCN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000064
    m_Localized: "G\xFCn ba\u015F\u0131nda rastgele bonus kazan\u0131l\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000065
    m_Localized: Oyuncular
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000066
    m_Localized: "({0}/{1} Mola Odas\u0131nda)"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000067
    m_Localized: "Beklenen M\xFC\u015Fteriler"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000068
    m_Localized: "K\u0131rm\u0131z\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000069
    m_Localized: Mavi
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000070
    m_Localized: "Sar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000071
    m_Localized: "Ye\u015Fil"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000072
    m_Localized: "G\xF6rev Yok"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000073
    m_Localized: "\xD6d\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000074
    m_Localized: Ceza
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000075
    m_Localized: "Tamamland\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000076
    m_Localized: "Ba\u015Far\u0131s\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000077
    m_Localized: '{0} kez mini oyunu tamamla'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000078
    m_Localized: Rafa {0} adet kutu koy
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000079
    m_Localized: Rafa {0} adet {1} kutu koy
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000080
    m_Localized: "{0} adet arac\u0131 tamamla"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000081
    m_Localized: "{0} m\xFC\u015Fteri ile ilgilen"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000082
    m_Localized: "{0} m\xFC\u015Fteriyi g\xF6rmezden gel"
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000083
    m_Localized: '{0} oyuncak paketle'
    m_Metadata:
      m_Items: []
  - m_Id: 30570000000000107
    m_Localized: "Bug\xFCn zaten bir g\xF6rev ald\u0131n"
    m_Metadata:
      m_Items: []
