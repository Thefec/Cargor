  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  ShowTopMostFoldoutHeaderGroup: 1
  isTutorialLevel: 1
  tutorialSteps:
  - stepName: Welcome
    stepIndex: 0
    instructionText: "Cargor'a ho\u015F geldin! E\u015Fyalar\u0131 m\xFC\u015Fterilerden
      al\u0131p ara\xE7lara teslim edeceksin. Devam etmek i\xE7in [SPACE]'e bas."
    instructionTextEnglish: Welcome to Cargor! You'll pick up items from customers
      and deliver them to trucks. Press [SPACE] to continue.
    conditionType: 9
    waitDuration: 3
    requiresItemPickup: 0
    requiredItemName: 
    requiredKey: 32
    triggerTag: 
    requiresSpecificBoxType: 0
    requiredBoxType: 0
    requiredDeliveryCount: 1
    requiresSpecificBoxTypeForTruck: 0
    requiredTruckBoxType: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
    objectToHighlight: {fileID: 0}
    targetPosition: {fileID: 0}
    showArrow: 0
    targetUIElement: {fileID: 0}
    isCompleted: 0
    stepStartTime: 0
    currentDeliveryCount: 0
  - stepName: TalkAndGetItem
    stepIndex: 1
    instructionText: "M\xFC\u015Fteriye gidip E'ye basarak sipari\u015Fini al, sonra
      masan\u0131n \xF6n\xFCnde tekrar E'ye basarak \xFCr\xFCn\xFC al."
    instructionTextEnglish: Walk up to the customer and press E, then press E again
      at the table to pick up the item.
    conditionType: 3
    waitDuration: 3
    requiresItemPickup: 0
    requiredItemName: 
    requiredKey: 0
    triggerTag: 
    requiresSpecificBoxType: 0
    requiredBoxType: 0
    requiredDeliveryCount: 1
    requiresSpecificBoxTypeForTruck: 0
    requiredTruckBoxType: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
    onStepComplete:
      m_PersistentCalls:
        m_Calls: []
    objectToHighlight: {fileID: 0}
    targetPosition: {fileID: 0}
    showArrow: 0
    targetUIElement: {fileID: 0}
    isCompleted: 0
    stepStartTime: 0
    currentDeliveryCount: 0
  - stepName: PlaceOnPackingTable
    stepIndex: 2
    instructionText: "\xDCr\xFCn\xFC paketleme masas\u0131na g\xF6t\xFCr ve \xF6n\xFCnde
      E'ye basarak b\u0131rak."
    instructionTextEnglish: Carry the item to the packing table and press E to place
      it down.
